generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  slug                 String    @unique
  /// What this workspace IS to us: 'internal' | 'partner' | 'customer'.
  /// Half of the platform-tier grant — an operator only holds the tier while
  /// they are in an internal workspace, so moving them revokes it with no flag
  /// to clear. Defaults to 'customer', which is the safe answer for every row
  /// that already exists. See src/lib/server/platform-roles.ts.
  kind                 String    @default("customer")
  // Workspace avatar shown in the org switcher — a small data URL (client
  // resizes to 128px before upload) so no external storage is required.
  logoUrl              String?
  plan                 Plan      @default(TRIAL)
  // Stripe billing linkage. Customer is created lazily on first checkout;
  // subscription id tracks the single active subscription for the org.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  // Mirrors the Stripe subscription's trial_end while it is trialing, and is
  // cleared once it isn't. Display only — access is decided by `plan`.
  trialEndsAt          DateTime? @db.Timestamptz(6)
  // Stamped by the Stripe webhook the first time a `trialing` subscription is
  // seen. Non-null means the one free trial is spent, so a later checkout
  // charges immediately. Never reset, never moved forward.
  trialStartedAt       DateTime? @db.Timestamptz(6)
  // Stamped on the first invoice we actually collect money on. Distinguishes
  // "card failed on day 15, never paid us" (lock out) from "long-time customer
  // whose card expired" (keep access while Stripe retries) on past_due.
  firstPaidAt          DateTime? @db.Timestamptz(6)
  // Existing test workspaces were permanently comped when paid activation
  // launched. New workspaces leave this null and must subscribe.
  grandfatheredAt      DateTime? @db.Timestamptz(6)
  // Freeform org-level settings grab-bag (e.g. `disableConnectionScans`).
  settings             Json      @default("{}")
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)

  users                     User[]
  agents                    AgentTask[]
  agentWorkers              AgentWorker[]
  agentRequests             AgentRequest[]
  externalAgentBindings     ExternalAgentBinding[]
  storeListings             StoreListing[]
  agentInstalls             AgentInstall[]
  apiKeys                   ApiKey[]
  vectorDocuments           FlowVectorDocument[]
  executions                AgentExecution[]
  templates                 AgentTemplate[]
  integrations              Integration[]
  notifications             Notification[]
  mcpConnections            McpConnection[]
  nangoConnections          NangoConnection[]
  googleOAuthConnections    GoogleOAuthConnection[]
  postgresConnections       PostgresConnection[]
  integrationSecrets        IntegrationSecret[]
  activityEvents            ActivityEvent[]
  activityBackfills         ActivityBackfill[]
  processBaselines          ProcessBaseline[]
  auditEvents               AuditEvent[]
  agentMemories             AgentMemory[]
  flowVersions              FlowVersion[]
  flows                     Flow[]
  pushSubscriptions         PushSubscription[]
  knowledgeDocuments        KnowledgeDocument[]
  creditGrants              CreditGrant[]
  sharedSkills              SharedSkill[]
  invitations               OrganizationInvitation[]
  flowCollaborators         FlowCollaborator[]
  flowComments              FlowComment[]
  slackWorkspaceConnections SlackWorkspaceConnection[]
  slackThreadSessions       SlackThreadSession[]
  userEvents                UserEvent[]
  credentials               Credential[]
  userPatterns              UserPattern[]
  userSuggestions           UserSuggestion[]
  persona                   OrganizationPersona?
  goals                     Goal[]
  goalMetrics               GoalMetric[]
  metricDatapoints          MetricDatapoint[]
  goalContributions         GoalContribution[]
  goalPeriods               GoalPeriod[]
  goalRecoveryPlans         GoalRecoveryPlan[]
  goalRecoveryActions       GoalRecoveryAction[]
  goalWork                  GoalWork[]
  goalWorkRules             GoalWorkRule[]
  goalRunVerdicts           GoalRunVerdict[]
  emailSends                EmailSend[]
  feedbackSubmissions       FeedbackSubmission[]
  flowDispatchOutbox        FlowDispatchOutbox[]
  flowSideEffects           FlowSideEffect[]
  flowLearningObservations  FlowLearningObservation[]
  flowLearningFeedback      FlowLearningFeedback[]
  queueDeadLetters          QueueDeadLetter[]
  workspaceVariables        WorkspaceVariable[]
  flowStaticData            FlowStaticData[]
  evalDatasets              EvalDataset[]
  evalCases                 EvalCase[]
  evalRuns                  EvalRun[]
  evalCaseResults           EvalCaseResult[]

  @@map("organizations")
}

model User {
  id                    String    @id @default(cuid())
  supabaseId            String    @unique @db.Uuid
  email                 String?
  name                  String?
  imageUrl              String?
  role                  UserRole  @default(MEMBER)
  /// Platform tier, spanning workspaces: null | 'staff' | 'operator'. Separate
  /// from `role`, which is org-scoped — see src/lib/server/platform-roles.ts.
  /// Only meaningful together with the organization's `kind`.
  platformRole          String?
  organizationId        String?   @db.Uuid
  isActive              Boolean   @default(true)
  lastSeenAt            DateTime? @db.Timestamptz(6)
  // Stamped the first time a session proves AAL2 (a verified second factor).
  // Once set, elevated/admin actions require AAL2 — so a stolen AAL1 session
  // cannot take over another member's resources. Non-lockout: unset means the
  // account never enrolled and the gate stays inert. See src/lib/server/mfa.ts.
  mfaEnrolledAt         DateTime? @db.Timestamptz(6)
  metadata              Json?
  // Suppresses marketing email (onboarding drip, win-back, goal digest).
  // Transactional email (trial-ending, dunning, welcome) always sends.
  marketingEmailsOptOut Boolean   @default(false)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  organization       Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions         AgentExecution[]
  templates          AgentTemplate[]
  integrations       Integration[]
  ownedAgents        AgentTask[]
  apiKeys            ApiKey[]
  ownedAgentWorkers  AgentWorker[]
  mcpConnections     McpConnection[]
  flowCollaborations FlowCollaborator[]         @relation("FlowCollaboratorUser")
  flowInvitesSent    FlowCollaborator[]         @relation("FlowCollaboratorInviter")
  flowComments       FlowComment[]              @relation("FlowCommentAuthor")
  identities         UserIdentity[]
  credentials        Credential[]
  integrationSecrets IntegrationSecret[]
  slackConnections   SlackWorkspaceConnection[]
  goals              Goal[]
  agentRequests      AgentRequest[]

  @@index([organizationId])
  @@map("users")
}

// One row per first-party product email attempt. The unique key is the
// exactly-once boundary for retried webhook and scheduled deliveries.
model EmailSend {
  id             String          @id @default(cuid())
  organizationId String          @db.Uuid
  userId         String?
  emailKey       String
  dedupeKey      String          @unique
  to             String
  subject        String
  status         EmailSendStatus @default(PENDING)
  attempts       Int             @default(1)
  error          String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  sentAt         DateTime?       @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("email_sends")
}

enum EmailSendStatus {
  PENDING
  SENT
  FAILED
}

// Feedback is persisted before its best-effort email forward, so a transport
// outage never loses the user's report.
model FeedbackSubmission {
  id             String           @id @default(cuid())
  organizationId String           @db.Uuid
  userId         String
  category       FeedbackCategory
  message        String           @db.Text
  path           String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("feedback_submissions")
}

enum FeedbackCategory {
  COMPLAINT
  IDEA
  QUESTION
  OTHER
}

// Extra Supabase auth identities resolving to one app user. The first
// identity stays on users.supabaseId; each additional sign-in method for the
// same verified email (e.g. Google after email/password) gets a row here so
// EVERY method lands on the same user row — one workspace, one ownership
// identity, regardless of how the person signs in.
model UserIdentity {
  id         String   @id @default(cuid())
  supabaseId String   @unique @db.Uuid
  userId     String
  // Auth provider that minted this identity (e.g. 'google', 'email') — for
  // support/debugging only, never authorization.
  provider   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_identities")
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String       @db.Uuid
  email          String
  role           UserRole     @default(MEMBER)
  invitedById    String?
  expiresAt      DateTime     @db.Timestamptz(6)
  acceptedAt     DateTime?    @db.Timestamptz(6)
  revokedAt      DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

model AgentTask {
  id              String    @id @default(cuid())
  agentType       String    @default("CUSTOM")
  description     String    @db.Text
  objective       String    @db.Text
  goal            String?   @db.Text
  schedule        Json      @default("{}")
  status          String    @default("ACTIVE")
  folder          String?
  /// The roster identity this agent works under. Null means it stands alone
  /// and renders as its own tile — which is why no existing agent needed a
  /// backfill when workers were introduced.
  workerId        String?
  visibility      String    @default("private")
  organizationId  String    @db.Uuid
  userId          String?
  metadata        Json?
  /// Where this agent's work executes: 'native' (Sublime's own tool loop) or
  /// 'external' (a service the workspace brought — see ExternalAgentBinding).
  runtime         String    @default("native")
  /// What this agent may DO, per plane — see src/lib/agents/grants.ts.
  /// NULL = legacy, unrestricted (its behaviour before grants existed). Read
  /// LIVE by every run, never from publishedConfig: a permission change must
  /// take effect immediately, not on the next publish.
  grants          Json?
  /// The config scheduled and triggered runs actually execute.
  ///
  /// Mirrors Flow.publishedGraph. NULL means this agent has never been
  /// published and runs read the live columns — which is exactly today's
  /// behaviour, so no existing agent changes when this ships. Once an agent
  /// IS published, edits land on the live columns as a draft and runs keep
  /// using this snapshot until it is published again.
  publishedConfig Json?
  publishedAt     DateTime?
  /// Bumped on each publish, so a run can record which version produced it.
  version         Int       @default(1)
  lastExecutedAt  DateTime?
  executionCount  Int       @default(0)
  lastResult      Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  worker          AgentWorker?          @relation(fields: [workerId], references: [id], onDelete: SetNull)
  executions      AgentExecution[]
  chatMessages    AgentChatMessage[]
  chatSessions    AgentChatSession[]
  connectors      AgentConnector[]
  memories        AgentMemory[]
  requests        AgentRequest[]
  evalDatasets    EvalDataset[]
  externalBinding ExternalAgentBinding?
  install         AgentInstall?

  @@index([organizationId, status])
  @@index([organizationId, userId, status, updatedAt])
  @@index([workerId])
  @@index([organizationId, visibility, status, updatedAt])
  @@index([userId])
  // Cross-org scans (cron scheduling tick, worker schedule registrar) filter
  // on status alone; every other index leads with organizationId, so without
  // this they sequential-scan the table every 15 minutes / 60 seconds.
  @@index([status])
  @@map("agent_tasks")
}

/// A person-shaped identity on the roster: one avatar, one role, and the agents
/// that do the work grouped underneath it. Templates are added TO a worker
/// rather than each becoming a standalone agent, so a single avatar can hold a
/// group of agents doing different jobs.
///
/// Deliberately thin: it owns presentation identity only. Everything about HOW
/// work runs stays on AgentTask, so a worker can be renamed, re-skinned, or
/// deleted without touching a single run.
model AgentWorker {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  userId         String?
  name           String
  /// Seed for the generated portrait (lib/agents/avatar.ts). Null = derive from id.
  avatarSeed     String?
  /// Generated one-or-two-word role shown under the name (lib/agents/role-label.ts).
  roleLabel      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  agents       AgentTask[]

  @@index([organizationId, updatedAt])
  @@map("agent_workers")
}

/// Typed binding between an agent and a connector it uses. Replaces matching
/// fuzzy strings against the agent's `metadata.integrations` JSON with real
/// rows: a canonical connector key, its plane (kind), and — for a per-org MCP
/// connection — a foreign key with referential integrity (deleting the
/// connection nulls the binding instead of leaving a dangling string).
model AgentConnector {
  id              String   @id @default(cuid())
  agentTaskId     String
  organizationId  String   @db.Uuid
  /// Canonical selection key (registry key or connection name).
  connectorKey    String
  /// Plane: 'builtin' | 'nango' | 'mcp' | 'external'.
  kind            String   @default("external")
  /// Optional FK to a specific per-org MCP connection this binding targets.
  mcpConnectionId String?
  config          Json     @default("{}")
  createdAt       DateTime @default(now())

  agentTask     AgentTask      @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  mcpConnection McpConnection? @relation(fields: [mcpConnectionId], references: [id], onDelete: SetNull)

  @@unique([agentTaskId, connectorKey])
  @@index([organizationId])
  @@index([mcpConnectionId])
  @@map("agent_connectors")
}

/// Durable, agent-scoped memory: answers to clarifying questions, learnings
/// distilled from executions, and proactive suggestions. Retrieved by kind +
/// status to ground future runs without re-asking or re-deriving.
model AgentMemory {
  id             String  @id @default(cuid())
  organizationId String  @db.Uuid
  agentId        String
  kind           String // 'user_answer' | 'learning' | 'suggestion'
  title          String
  content        String  @db.Text
  question       String? @db.Text
  embedding      Json?

  /// pgvector copy of `embedding` (WS-R5). Reads/writes go through raw SQL —
  /// Prisma cannot query Unsupported columns. The Json column is legacy,
  /// kept for deploy-window safety; drop it in a future migration.
  embeddingVec Unsupported("vector(1024)")?

  sourceExecutionId String?
  /// Stable key `<plane>:<connectionRef>` identifying the connection this
  /// memory was distilled from (e.g. `mcp:cmcpconn123`), set at save time by
  /// the connection scan. Nullable: only scan-derived learnings carry it —
  /// other memory kinds (user_answer, agent-authored suggestions) leave it
  /// null. Powers a precise purge query when a connection is disconnected,
  /// instead of matching against title/content strings.
  sourceRef         String?
  status            String    @default("open") // 'open' | 'dismissed' | 'superseded'
  timesUsed         Int       @default(0)
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        AgentTask    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([organizationId, agentId, kind, status])
  @@index([organizationId, sourceRef])
  // HNSW index created by hand-edited migration SQL (Prisma's schema DSL has
  // no `hnsw`/`vector_cosine_ops` vocabulary); declaring it here keeps
  // `prisma migrate diff` from proposing to drop it as drift.
  @@index([embeddingVec], map: "agent_memories_embedding_vec_hnsw")
  @@map("agent_memories")
}

/// A published agent package: a versioned definition another workspace can
/// install as a teammate. `definition` is a snapshot (see lib/store/listing.ts)
/// and NEVER carries a secret — an external listing names the publisher's
/// endpoint, and each installer supplies its own credential. No organizationId
/// column on purpose: public listings are cross-workspace by design, so this
/// model sits outside the tenant guard and every query scopes by visibility.
model StoreListing {
  id                      String   @id @default(cuid())
  publisherOrganizationId String   @db.Uuid
  slug                    String
  name                    String
  description             String   @default("")
  category                String   @default("Community")
  /// 'native' | 'external'
  kind                    String
  /// 'organization' (the publisher's workspace only) | 'public'
  visibility              String   @default("organization")
  /// Bumped on every re-publish; installs remember the version they took.
  version                 Int      @default(1)
  definition              Json
  sourceAgentTaskId       String?
  publishedById           String?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @db.Timestamptz(6)

  publisher Organization   @relation(fields: [publisherOrganizationId], references: [id], onDelete: Cascade)
  installs  AgentInstall[]

  @@unique([publisherOrganizationId, slug])
  @@index([visibility, isActive, updatedAt])
  @@map("store_listings")
}

/// One workspace's install of a listing: which version it took and which
/// agent it became, so an update can be offered without overwriting local
/// edits (compare the agent's updatedAt to this row's).
model AgentInstall {
  id               String   @id @default(cuid())
  organizationId   String   @db.Uuid
  listingId        String
  agentTaskId      String   @unique
  installedVersion Int
  installedById    String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing      StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  agentTask    AgentTask    @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)

  @@index([organizationId, listingId])
  @@map("agent_installs")
}

/// Where an external agent lives. One per agent; the agent's `runtime` must be
/// 'external' for it to matter. Sublime POSTs each ask to `endpointUrl`
/// (SSRF-guarded on save AND on every dispatch) and the service answers
/// inline or calls back with a single-use, run-bound token — see
/// docs/external-agents.md for the contract.
model ExternalAgentBinding {
  id             String @id @default(cuid())
  organizationId String @db.Uuid
  agentTaskId    String @unique

  endpointUrl    String
  /// 'none' | 'bearer' | 'header'
  authType       String @default("none")
  /// { headerName?, secretEnc? } — the secret is AES-GCM ciphertext, never plain.
  authConfig     Json   @default("{}")
  /// How long a parked run waits for the callback before it is failed.
  timeoutMinutes Int    @default(10)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentTask    AgentTask    @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("external_agent_bindings")
}

/// A piece of work a human addressed to an agent.
///
/// Deliberately NOT GoalWork. A GoalWork row is agent-PRODUCED and its
/// disposition ledger records what a human did with that output; the
/// assignee there is the person who must act. This table is the opposite
/// direction — a person asks, the agent answers — and overloading one table
/// with both would make `disposition` mean two contradictory things and
/// corrupt the rule learning that reads it.
///
/// `text` is the requester's words verbatim. It is the task, never the
/// agent's job description: the standing `AgentTask.objective` frames the
/// run and this specifies it, so an agent asked for work outside its
/// objective declines (see the decline_request tool) rather than silently
/// becoming a generalist with its owner's credentials.
model AgentRequest {
  id             String @id @default(cuid())
  organizationId String @db.Uuid

  /// SetNull, not Cascade: the ask outlives the person who made it.
  requestedByUserId String?
  /// The addressee. A request without one is meaningless, so this cascades.
  agentTaskId       String
  /// Set by the goal composer; null for a Slack request in a channel that
  /// maps to no goal. A goal-bound request can contribute to that goal.
  goalId            String?

  /// The human's words, verbatim.
  text String @db.Text

  /// Where the ask came from: 'app' | 'slack'.
  origin     String @default("app")
  /// Origin-specific routing. For Slack this is shaped exactly like
  /// slackRunTrigger()'s `slack` block, so the reply path reads one shape
  /// regardless of which surface opened the thread.
  originMeta Json   @default("{}")

  /// pending | running | waiting | completed | failed | declined | cancelled
  /// Legal moves live in src/lib/agents/request-transitions.ts, not here.
  status      String  @default("pending")
  /// The run that answered it. Null until the job is claimed.
  executionId String?
  /// The agent's answer, once settled.
  result      String? @db.Text
  /// Failure reason, or — for `declined` — why the agent judged the ask
  /// outside its objective. User-facing text either way.
  error       String? @db.Text

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  settledAt DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  agentTask    AgentTask    @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  goal         Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)

  /// "My requests", newest first.
  @@index([organizationId, requestedByUserId, status, createdAt])
  /// One agent's ask history — what the item-2 profile route will read.
  @@index([organizationId, agentTaskId, createdAt])
  @@index([organizationId, goalId])
  /// The settle path resolves a request from the run that answered it.
  @@index([executionId])
  @@map("agent_requests")
}

// Agent-scoped assistant chat (persistent per agent + user, not per execution).
// Additive: new table only. `metadata` carries assistant proposals and their
// applied-at marker, mirroring the JSON grab-bag pattern used elsewhere.
model AgentChatMessage {
  id             String   @id @default(cuid())
  agentTaskId    String
  organizationId String   @db.Uuid
  userId         String
  // Groups messages into a conversation. Nullable so pre-existing flat threads
  // (before sessions) read as one implicit "Earlier conversation".
  sessionId      String?
  role           String
  content        String   @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())

  agentTask AgentTask         @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  session   AgentChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([agentTaskId, userId, createdAt])
  @@index([sessionId, createdAt])
  @@map("agent_chat_messages")
}

// A single assistant conversation for one agent + user. Multiple sessions per
// agent give users a "new chat" and a browsable history, scoped per agent.
model AgentChatSession {
  id             String   @id @default(cuid())
  agentTaskId    String
  organizationId String   @db.Uuid
  userId         String
  // Auto-derived from the first user message; null until the first message.
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agentTask AgentTask          @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  messages  AgentChatMessage[]

  @@index([agentTaskId, userId, updatedAt])
  @@map("agent_chat_sessions")
}

// Workspace-level Home assistant chat (not agent-scoped). Sessions are per
// user; messages carry metadata for attachments, created agents, and runs.
model AssistantChatSession {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  userId         String
  // Auto-derived from the first user message.
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages AssistantChatMessage[]

  @@index([organizationId, userId, updatedAt])
  @@map("assistant_chat_sessions")
}

model AssistantChatMessage {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  userId         String
  sessionId      String
  role           String
  content        String   @db.Text
  // attachment { filename, text, truncated? } | createdAgent { id, title,
  // icon, description } | executedRun { executionId, agentId, status } |
  // action { type, agentId }
  metadata       Json?
  createdAt      DateTime @default(now())

  session AssistantChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("assistant_chat_messages")
}

model AgentExecution {
  id              String    @id @default(cuid())
  agentType       String
  agentTemplateId String?
  agentTaskId     String?
  // Replay/duplicate guard for externally triggered runs.
  idempotencyKey  String?
  status          String    @default("pending")
  input           Json
  output          Json?
  error           String?
  executionTime   Int?      @default(0)
  trigger         Json
  metadata        Json?
  model           String?
  transcript      Json?
  /// Persisted in-run plan artifact { steps, revisions } written by the
  /// set_plan/update_plan tools (features/agents/plan-artifact.ts). Null when
  /// the run never planned; pruned with the run like the transcript.
  plan            Json?
  inputTokens     Int       @default(0)
  outputTokens    Int       @default(0)
  userId          String
  organizationId  String    @db.Uuid
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentTemplate AgentTemplate?     @relation(fields: [agentTemplateId], references: [id], onDelete: SetNull)
  agentTask     AgentTask?         @relation(fields: [agentTaskId], references: [id], onDelete: SetNull)
  workflowSteps WorkflowStep[]
  events        WorkflowEvent[]
  messages      ExecutionMessage[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, startedAt])
  @@index([organizationId, userId, agentTaskId, startedAt])
  @@index([agentTaskId])
  // Reaper sweeps (stuck/cancelling/pending) filter on status + startedAt
  // globally; without this every 15-minute tick sequential-scans the table.
  @@index([status, startedAt])
  @@map("agent_executions")
}

model ExecutionMessage {
  id          String   @id @default(cuid())
  executionId String
  role        String
  content     String   @db.Text
  createdAt   DateTime @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@map("execution_messages")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  userId         String?
  type           String
  level          String    @default("info")
  title          String
  body           String?   @db.Text
  agentTaskId    String?
  executionId    String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, readAt])
  @@index([organizationId, userId, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  organizationId String   @db.Uuid
  endpoint       String   @unique @db.Text
  p256dh         String   @db.Text
  auth           String   @db.Text
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model WorkflowStep {
  id          String    @id @default(cuid())
  executionId String
  node        String
  status      String
  input       Json      @default("{}")
  output      Json?
  error       Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  execution AgentExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  events    WorkflowEvent[]

  @@index([executionId, createdAt])
  @@map("workflow_steps")
}

model WorkflowEvent {
  id          String   @id @default(cuid())
  executionId String
  stepId      String?
  kind        String
  payload     Json?
  ts          DateTime @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step      WorkflowStep?  @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([executionId, ts])
  @@map("workflow_events")
}

// Append-only audit trail of consequential actions (tool writes, config
// changes, connections, approvals). Never updated or deleted in normal
// operation; exportable per org for enterprise compliance.
model AuditEvent {
  id             String   @id @default(cuid())
  // Nullable ON PURPOSE: deleting a workspace must not shred its audit trail.
  // The org FK is SET NULL so rows survive the cascade as orphans a DB
  // operator can still read (including the organization.deleted row itself).
  organizationId String?  @db.Uuid
  actorUserId    String?
  /// Which AGENT acted, when actorKind is 'agent'. actorUserId stays the human
  /// whose credentials it ran with; this makes the agent dimension queryable
  /// without a join through executions.
  actorAgentId   String?
  actorKind      String   @default("user") // 'user' | 'agent' | 'system'
  action         String // e.g. 'tool.write', 'agent.config_changed'
  resourceType   String?
  resourceId     String?
  tool           String?
  executionId    String?
  // Hash (not contents) of the payload — proves what happened without storing
  // potentially sensitive tool arguments in the audit row.
  payloadHash    String?
  detail         Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([organizationId, actorAgentId])
  @@map("audit_events")
}

model AgentTemplate {
  id             String   @id @default(cuid())
  name           String
  description    String?  @db.Text
  type           String
  configuration  Json?
  isActive       Boolean  @default(true)
  schedule       String?
  priority       String   @default("MEDIUM")
  metadata       Json?
  userId         String
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AgentExecution[]

  @@index([organizationId, isActive])
  @@map("agent_templates")
}

// LEGACY — unused. Nothing in the app reads or writes this table; live
// connections are stored in NangoConnection (OAuth providers) and
// McpConnection (MCP servers). The last reader (the assistant's workspace
// context) was removed because it only ever reported `connected: false`.
// Kept in the schema so the existing table/columns are not dropped by a
// migration; do not build on it — add to NangoConnection/McpConnection.
model Integration {
  id             String    @id @default(cuid())
  userId         String
  organizationId String    @db.Uuid
  provider       String
  expiresAt      DateTime? @db.Timestamptz(6)
  scopes         String[]  @default([])
  status         String    @default("connected")
  failCount      Int       @default(0)
  lastError      String?   @db.Text
  metadata       Json      @default("{}")
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([organizationId, provider])
  @@map("integrations")
}

model McpConnection {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  // Personal connection when set (e.g. a per-user MCP row);
  // null = org-shared server added via the connections page.
  userId         String?
  // Platform-managed provider slug; null = user-added server.
  provider       String?
  name           String
  description    String?
  serverUrl      String
  authType       String    @default("none") // 'none' | 'api_key' | 'oauth2'
  authConfig     Json      @default("{}") // encrypted secret blob + non-secret fields
  isActive       Boolean   @default(true)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentBindings AgentConnector[]

  @@unique([organizationId, userId, provider])
  @@index([organizationId, isActive])
  @@index([organizationId, userId, isActive])
  @@map("mcp_connections")
}

// Mirror of a Nango connected account, scoped per-organization. Nango owns
// the credentials; we only persist connection ids and health for listing.
model NangoConnection {
  id                String   @id @default(cuid())
  organizationId    String   @db.Uuid
  userId            String?
  connectionId      String
  providerConfigKey String
  provider          String?
  status            String   @default("connected")
  lastError         String?  @db.Text
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, connectionId])
  @@index([organizationId, providerConfigKey])
  @@index([organizationId, userId, status])
  @@index([organizationId, userId, updatedAt])
  @@map("nango_connections")
}

// Native Google OAuth connections (Google blocks Nango's flow). The encrypted
// refresh token lives HERE; a NangoConnection row with provider
// 'google-native' mirrors each record so every existing read path (grid,
// status, tool plane, scan plane) works unchanged.
model GoogleOAuthConnection {
  id              String   @id @default(cuid())
  organizationId  String   @db.Uuid
  userId          String
  service         String // e.g. 'google-mail'
  accountEmail    String
  scopes          String[] @default([])
  refreshTokenEnc String   @db.Text
  status          String   @default("connected")
  lastError       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, service, accountEmail])
  @@index([organizationId, service])
  @@map("google_oauth_connections")
}

/// A customer-owned Postgres database connected natively (Nango has no
/// Postgres provider). The connection string lives HERE, encrypted with the
/// same helpers the credential vault uses; a NangoConnection row with provider
/// 'postgres-native' mirrors each record so every existing read path (the
/// integrations grid, /api/nango/status, the tool plane, the scan plane) works
/// unchanged — the same trick GoogleOAuthConnection uses above.
///
/// Org-scoped, not per-user: a production database is org infrastructure, so
/// writes to this table require an ADMIN.
///
/// `allowWrites` is a COLUMN, never a field inside authConfig, so the tool
/// catalog can filter on "may this be written to?" without decrypting a secret
/// to read a policy flag.
model PostgresConnection {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  name           String
  /// encryptSecret() blobs: { connectionString, caCert? }. Never returned to a client.
  authConfig     Json      @default("{}")
  /// Non-secret display target derived from the connection string at save
  /// time — 'host:5432/dbname', never user or password. Lets the list endpoint
  /// stay a plain read with no decryption.
  displayTarget  String    @default("")
  /// Opt-in per database, OFF by default. Even when true, writes are data-only
  /// (no DDL) and always pause an agent run for human approval.
  allowWrites    Boolean   @default(false)
  defaultSchema  String    @default("public")
  status         String    @default("untested") // untested | connected | error
  lastError      String?   @db.Text
  createdById    String?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("postgres_connections")
}

// Per-organization secret for built-in integrations (e.g. the Granola API
// key). authConfig holds the encrypted blob produced by buildAuthConfig().
model IntegrationSecret {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  /// Owner of the secret inside the workspace. Legacy null rows are inactive
  /// quarantine records and are never selected for execution.
  userId         String?
  provider       String
  authType       String   @default("api_key") // 'none' | 'api_key' | 'oauth2'
  authConfig     Json     @default("{}") // encrypted secret blob + non-secret fields
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, provider])
  @@index([organizationId, userId, isActive])
  @@map("integration_secrets")
}

/// Reusable, workspace-shared credential for authenticating outbound requests
/// from flow nodes: every active org member can list (redacted), attach, edit,
/// and run with it. userId/createdById are provenance only. authConfig holds
/// encryptSecret() blobs for secret fields plus plaintext metadata
/// (headerName, queryParam, username). Legacy pre-vault rows may have a null
/// userId but are inactive and never selected. Empty allowedDomains fail
/// closed at runtime.
model Credential {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  userId         String?
  name           String
  type           String // basic | bearer | custom | digest | apiKeyHeader | oauth1 | oauth2 | apiKeyQuery
  authConfig     Json      @default("{}")
  allowedDomains String[]  @default([])
  isActive       Boolean   @default(true)
  createdById    String?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, name])
  @@index([organizationId, isActive])
  @@index([organizationId, userId, isActive])
  @@map("credentials")
}

/// Whether a credential/connection has been proven to work, keyed by the exact
/// id the flow tool catalog uses (a raw McpConnection cuid, native:<provider>,
/// nango:<capability>, or credential:<id>). One uniform table rather than a
/// verified flag on four different models.
///
/// Written by explicit tests, by the OAuth callback, and by every real run —
/// that last writer is what catches DRIFT, where a credential valid at save
/// time expires later.
model ConnectionVerification {
  organizationId String   @db.Uuid
  connectionId   String
  state          String // verified | failed
  checkedAt      DateTime
  error          String?  @db.Text

  @@id([organizationId, connectionId])
  @@map("connection_verifications")
}

/// A visual agent pipeline: a graph of steps, each running a workspace agent
/// via runAgentExecution. Distinct from WorkflowStep/WorkflowEvent (those are a
/// single agent's internal tool-call trace). See docs/superpowers/specs.
/// Workspace-scoped constants, referenced from a flow as {{workspace.<key>}}.
///
/// n8n calls these $vars. Deliberately NOT `{{vars.x}}` here: `{{var.x}}`
/// already exists and is FLOW-scoped (written by variable steps), and two
/// scopes one letter apart is a footgun that would be found in production.
///
/// Values are plain text and readable by any member — a channel id, a
/// threshold, a base URL. Secrets belong in the credential vault, which has
/// placeholder-only reveal and rotation; this table deliberately has neither,
/// and the API refuses to store anything that looks like a credential.
model WorkspaceVariable {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  /// Lowercase, dot-free identifier — dots would be ambiguous against the
  /// token path grammar ({{workspace.a.b}} could mean two things).
  key            String
  value          String   @db.Text
  description    String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("workspace_variables")
}

/// Per-flow state that survives between runs — n8n's $getWorkflowStaticData.
///
/// One row per (flow, key) rather than a blob on Flow: two keys written by
/// different steps in the same run would otherwise race on one JSON column,
/// and last-write-wins there means a silently dropped cursor.
/// A key that authenticates a machine caller against the public API.
///
/// The plaintext is shown once and never stored. `prefix` is public by design
/// — it is how a key is identified in a list and how a presented key finds its
/// own row — and `hash` is what proves the presenter holds the real thing.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  /// Who issued it. A key acts with WORKSPACE authority, not this person's, so
  /// this is provenance for the audit trail rather than an authorization input.
  createdById    String
  name           String
  /// Public handle. Unique because it is the lookup key for a presented token.
  prefix         String    @unique
  /// sha256 of the whole plaintext key.
  hash           String
  /// Closed vocabulary from lib/api-keys/keys.ts. Empty grants nothing.
  scopes         String[]  @default([])
  /// Set on use, best-effort — so an unused key can be found and removed.
  lastUsedAt     DateTime? @db.Timestamptz(6)
  expiresAt      DateTime? @db.Timestamptz(6)
  /// Revocation is a tombstone, never a delete: a deleted key leaves an audit
  /// trail pointing at a row that no longer exists.
  revokedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

/// A single public-API request, for per-key rate limiting and usage reporting.
model ApiKeyUsage {
  id             String   @id @default(cuid())
  apiKeyId       String
  /// Denormalised so the tenant guard can scope reads without a join.
  organizationId String   @db.Uuid
  route          String
  status         Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([apiKeyId, createdAt])
  @@index([organizationId, createdAt])
  @@map("api_key_usage")
}

/// A document in a flow-owned vector collection.
///
/// Separate from the agent knowledge graph on purpose: mixing arbitrary flow
/// documents into what agents reason over would change what every agent knows
/// as a side effect of someone building a flow.
///
/// The embedding column is added by migration (Prisma has no vector type) and
/// is therefore absent here — see 20260825050000_flow_vector_documents.
model FlowVectorDocument {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  /// Namespace within a workspace. Normalised — see lib/vector/collection.ts.
  collection     String
  /// Caller-supplied key, so re-embedding the same source updates in place
  /// rather than accumulating duplicates.
  externalId     String
  content        String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Org FIRST: the tenant guard requires organizationId in the where clause,
  /// and a (collection, externalId) unique would let a crafted collection name
  /// address another workspace's row.
  @@unique([organizationId, collection, externalId])
  @@index([organizationId, collection])
  @@map("flow_vector_documents")
}

model FlowStaticData {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  key            String
  value          Json     @default("{}")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Org FIRST: the tenant guard requires organizationId in the where clause,
  // and a (flowId, key) unique would let a crafted flowId address another
  // workspace's row. Scoping is structural rather than remembered.
  @@unique([organizationId, flowId, key])
  @@index([organizationId, flowId])
  @@map("flow_static_data")
}

/// A set of cases an agent is evaluated against.
model EvalDataset {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  /// The agent this dataset evaluates. Null = a shared set reusable by any.
  agentTaskId    String?
  name           String
  description    String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentTask    AgentTask?   @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  cases        EvalCase[]
  runs         EvalRun[]

  @@index([organizationId, agentTaskId])
  @@map("eval_datasets")
}

/// One case: an input, and what a good answer looks like.
model EvalCase {
  id             String   @id @default(cuid())
  datasetId      String
  organizationId String   @db.Uuid
  input          String   @db.Text
  /// Natural-language rubric the judge scores against.
  rubric         String   @db.Text
  /// Substrings the output must contain — a cheap deterministic check that
  /// needs no model call, so a dataset stays useful without a judge budget.
  mustContain    Json     @default("[]")
  createdAt      DateTime @default(now())

  dataset      EvalDataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  results      EvalCaseResult[]

  @@index([organizationId, datasetId])
  @@map("eval_cases")
}

/// One execution of a dataset against an agent.
model EvalRun {
  id             String    @id @default(cuid())
  datasetId      String
  organizationId String    @db.Uuid
  agentTaskId    String
  /// The agent version evaluated. THE point of persisting runs: without it
  /// "did this change make it better" is unanswerable.
  agentVersion   Int       @default(1)
  status         String    @default("running")
  passed         Int       @default(0)
  failed         Int       @default(0)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  dataset      EvalDataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  results      EvalCaseResult[]

  @@index([organizationId, datasetId, startedAt])
  @@map("eval_runs")
}

/// One case's outcome within a run.
model EvalCaseResult {
  id             String   @id @default(cuid())
  runId          String
  caseId         String
  organizationId String   @db.Uuid
  passed         Boolean
  /// 0..1 from the judge; null when only deterministic checks ran.
  score          Float?
  output         String   @db.Text
  notes          String   @default("")
  createdAt      DateTime @default(now())

  run          EvalRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  evalCase     EvalCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, runId])
  @@map("eval_case_results")
}

model Flow {
  id                          String   @id @default(cuid())
  name                        String
  description                 String   @default("")
  status                      String   @default("DRAFT") // DRAFT | ACTIVE | DISABLED
  trigger                     Json     @default("{}") // { type: 'manual'|'schedule'|'signal', ... }
  graph                       Json     @default("{}") // working draft: { nodes, edges }
  publishedGraph              Json? // the live version scheduled/triggered runs execute
  // Denormalized trigger/publish facts, maintained by the
  // flows_sync_trigger_columns DB trigger (NEVER write from app code — any
  // value set here is overwritten on write). They exist so event ingestion
  // (activity events, Slack messages, signals) and the scheduling tick can
  // find listening flows with an indexed SQL predicate instead of loading
  // every ACTIVE flow's published graph per event to match in memory.
  triggerType                 String? // = trigger->>'type'
  triggerKey                  String? // = trigger->>'signal' for signal triggers
  isPublished                 Boolean  @default(false) // = publishedGraph IS NOT NULL
  version                     Int      @default(1) // bumped on each publish
  visibility                  String   @default("private")
  /// Emoji shown on the flow card. '' = the generic Workflow glyph.
  /// Bounded and normalized by normalizeFlowIcon (lib/flows/organization.ts).
  icon                        String   @default("")
  /// Workbook-style grouping for the list view. '' = ungrouped. Matching is
  /// case-insensitive at display time (groupFlowsByFolder), so the stored
  /// casing is presentational only.
  folder                      String   @default("")
  organizationId              String   @db.Uuid
  userId                      String?
  // Freeform per-flow metadata grab-bag (e.g. behavioral-intelligence provenance).
  metadata                    Json?
  // Monotonic sequencer for durable Flow Jam graph patches.
  collaborationRevision       Int      @default(0)
  // Rotates the private Realtime topic whenever the collaborator allow-list changes.
  collaborationAccessRevision Int      @default(0)
  // Recently applied patch mutation ids (bounded string array) — makes patch
  // POSTs idempotent so a timed-out retry can't double-apply.
  collaborationMutationLog    Json     @default("[]")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs          FlowRun[]
  versions      FlowVersion[]
  collaborators FlowCollaborator[]
  comments      FlowComment[]
  nodePins      FlowNodePin[]
  staticData    FlowStaticData[]
  observations  FlowLearningObservation[]

  @@index([organizationId, updatedAt])
  // Event-side flow matching: activity/Slack/signal ingestion narrows to
  // listening flows in SQL (triggerKey checked in the WHERE for signals).
  @@index([organizationId, status, triggerType])
  @@map("flows")
}

/// Flow Jam threaded comments (Spec 3). Anchored to a node (survives node
/// moves) or unanchored for flow-level discussion; replies carry the root
/// comment's id as parentId (threads are one level deep). Resolution keeps the
/// row so a resolved thread can be reopened with its history intact.
model FlowComment {
  id             String    @id @default(cuid())
  flowId         String
  organizationId String    @db.Uuid
  userId         String
  parentId       String?
  anchorNodeId   String?
  /// Free canvas-point anchor: { space: 'dag'|'stack', x, y } in canvas coords.
  anchorPoint    Json?
  body           String
  resolvedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  flow         Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation("FlowCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  parent       FlowComment?  @relation("FlowCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      FlowComment[] @relation("FlowCommentThread")

  @@index([flowId, createdAt])
  @@index([organizationId, flowId])
  @@map("flow_comments")
}

/// Explicit per-flow edit access. Workspace membership alone never exposes a
/// personal flow; the owner must invite each collaborator through Flow Jam.
model FlowCollaborator {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  userId         String
  invitedById    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("FlowCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("FlowCollaboratorInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([flowId, userId])
  @@index([organizationId, userId])
  @@map("flow_collaborators")
}

model FlowVersion {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  version        Int
  graph          Json
  trigger        Json
  note           String?
  publishedAt    DateTime @default(now())
  publishedBy    String?

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([flowId, version])
  @@index([organizationId, flowId])
  @@map("flow_versions")
}

model FlowRun {
  id                     String    @id @default(cuid())
  flowId                 String
  status                 String    @default("running") // queued | claimed | running | waiting | stopping | stopped | succeeded | failed
  trigger                Json      @default("{}")
  input                  Json      @default("{}")
  output                 Json?
  error                  String?
  wakeAt                 DateTime?
  webhookResponse        Json?
  graphSnapshot          Json? // the graph definition this run executed against
  startedAt              DateTime  @default(now())
  finishedAt             DateTime?
  queuedAt               DateTime? @db.Timestamptz(6)
  claimedAt              DateTime? @db.Timestamptz(6)
  heartbeatAt            DateTime? @db.Timestamptz(6)
  leaseExpiresAt         DateTime? @db.Timestamptz(6)
  workerId               String?
  queueAttempt           Int       @default(0)
  waitGeneration         Int       @default(0)
  /// SHA-256 of the caller/provider idempotency token. Nullable for legacy or
  /// deliberately non-idempotent manual/test runs.
  idempotencyKey         String?
  idempotencyPayloadHash String?
  organizationId         String    @db.Uuid
  userId                 String?

  flow         Flow                      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  steps        FlowRunStep[]
  dispatch     FlowDispatchOutbox[]
  effects      FlowSideEffect[]
  observations FlowLearningObservation[]

  @@unique([organizationId, flowId, idempotencyKey])
  @@index([flowId, startedAt])
  // Workspace-wide execution log (GET /api/flows/runs): newest runs for one
  // tenant without scanning every flow's history.
  @@index([organizationId, startedAt])
  @@index([status, wakeAt])
  @@index([status, queuedAt])
  @@index([status, leaseExpiresAt])
  @@map("flow_runs")
}

/// Transactional DB -> BullMQ handoff. The run row and this intent are
/// created in the same transaction; a publisher may safely retry queue.add
/// because dispatchKey is also the stable BullMQ job id.
model FlowDispatchOutbox {
  id             String    @id @default(cuid())
  flowRunId      String
  organizationId String    @db.Uuid
  dispatchKey    String    @unique
  kind           String // fresh | resume
  payload        Json
  payloadHash    String
  status         String    @default("pending") // pending | publishing | published | consumed | failed
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @db.Timestamptz(6)
  lockedAt       DateTime? @db.Timestamptz(6)
  publishedAt    DateTime? @db.Timestamptz(6)
  consumedAt     DateTime? @db.Timestamptz(6)
  lastError      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  run          FlowRun      @relation(fields: [flowRunId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([organizationId, createdAt])
  @@map("flow_dispatch_outbox")
}

model FlowRunStep {
  id               String    @id @default(cuid())
  flowRunId        String
  nodeId           String
  agentExecutionId String?
  childFlowRunId   String? // subflow step: the child FlowRun this step ran
  iterationPath    String? // dot-joined 0-based loop indices ("0", "0.2" nested) disambiguating a loop-body step across iterations; null outside any loop body
  order            Int       @default(0)
  status           String    @default("queued") // queued | running | succeeded | failed | skipped | waiting
  input            Json      @default("{}")
  output           Json?
  error            String?
  startedAt        DateTime?
  finishedAt       DateTime?

  run     FlowRun          @relation(fields: [flowRunId], references: [id], onDelete: Cascade)
  effects FlowSideEffect[]

  @@index([flowRunId, order])
  @@map("flow_run_steps")
}

/// Durable exactly-once decision boundary for outbound effects. A provider can
/// only guarantee exactly-once delivery when it accepts our idempotency key;
/// otherwise an interrupted write is retained as `ambiguous` and requires an
/// operator decision instead of being submitted a second time.
model FlowSideEffect {
  id                String    @id @default(cuid())
  organizationId    String    @db.Uuid
  flowRunId         String
  flowRunStepId     String
  effectKey         String    @unique
  nodeId            String
  iterationPath     String?
  kind              String // tool | http
  provider          String
  operation         String
  safety            String // read | idempotent_write | unsafe_write
  providerKey       String?
  requestHash       String
  status            String    @default("claimed") // claimed | succeeded | failed | ambiguous
  attempts          Int       @default(0)
  response          Json?
  providerRequestId String?
  lastError         String?
  startedAt         DateTime  @default(now()) @db.Timestamptz(6)
  completedAt       DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          FlowRun      @relation(fields: [flowRunId], references: [id], onDelete: Cascade)
  step         FlowRunStep  @relation(fields: [flowRunStepId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, updatedAt])
  @@index([flowRunId, nodeId])
  @@map("flow_side_effects")
}

/// Privacy-bounded facts learned from a flow execution. `features` and
/// `evidence` contain structural metadata (node ids/types, timings, status),
/// never prompts, tool arguments, provider response bodies, or credentials.
model FlowLearningObservation {
  id             String   @id @default(cuid())
  observationKey String   @unique
  organizationId String   @db.Uuid
  userId         String?
  flowId         String
  flowRunId      String
  nodeId         String?
  kind           String // run_outcome | step_outcome | recovery
  subject        String
  outcome        String // succeeded | failed | stopped | waiting | ambiguous
  features       Json     @default("{}")
  evidence       Json     @default("{}")
  occurredAt     DateTime @default(now()) @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flow         Flow                   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  run          FlowRun                @relation(fields: [flowRunId], references: [id], onDelete: Cascade)
  feedback     FlowLearningFeedback[]

  @@index([organizationId, flowId, occurredAt])
  @@index([organizationId, subject, outcome])
  @@map("flow_learning_observations")
}

/// Outcome feedback closes the learning loop without rewriting history. It is
/// append-only and points to the exact observation/evidence being evaluated.
model FlowLearningFeedback {
  id             String   @id @default(cuid())
  observationId  String
  organizationId String   @db.Uuid
  userId         String?
  source         String // human | downstream | system
  outcome        String // worked | failed | corrected | accepted | rejected
  score          Int?
  note           String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  observation  FlowLearningObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, observationId, createdAt])
  @@index([organizationId, outcome, createdAt])
  @@map("flow_learning_feedback")
}

/// Database-backed DLQ. Redis is transport, not the source of truth: these
/// rows survive queue retention/flushes and carry an audited replay lifecycle.
model QueueDeadLetter {
  id               String    @id @default(cuid())
  organizationId   String?   @db.Uuid
  queue            String
  sourceJobId      String?
  executionType    String // flow | agent | backfill
  executionId      String?
  outboxId         String?
  payload          Json      @default("{}")
  error            String
  status           String    @default("open") // open | replaying | replayed | dismissed | replay_failed
  replayAttempts   Int       @default(0)
  lastReplayError  String?
  replayedByUserId String?
  replayedAt       DateTime? @db.Timestamptz(6)
  resolvedAt       DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([queue, status, createdAt])
  @@map("queue_dead_letters")
}

/// A pinned node output: a dev-time fixture so testing a step doesn't re-hit an
/// upstream API. Deliberately NOT stored in Flow.graph — pins must never reach
/// publishedGraph or /export, and they are per-user working state, not part of
/// the flow definition.
model FlowNodePin {
  id             String   @id @default(cuid())
  flowId         String
  nodeId         String
  userId         String
  organizationId String   @db.Uuid
  output         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, nodeId, userId])
  @@index([flowId, userId])
  @@map("flow_node_pins")
}

/// Per-org Slack bot binding: one row per (org, Slack workspace). botToken and
/// signingSecret hold {"value": "<encryptSecret payload>"} — never plaintext.
model SlackWorkspaceConnection {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  /// Authenticated user who supplied this workspace credential. Legacy null
  /// rows are revoked by migration and never selected for user execution.
  userId         String?
  teamId         String // Slack workspace id (T…), captured from auth.test
  teamName       String?
  botUserId      String // U… — the bot's own user id, for echo-guarding
  botToken       Json // encrypted at rest (secrets.ts shape)
  signingSecret  Json // encrypted at rest
  status         String   @default("active") // active | error | revoked
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, teamId])
  @@index([organizationId, userId, status])
  @@map("slack_workspace_connections")
}

/// One Slack thread ↔ one flow conversation. Keyed by the reply thread; tracks
/// the latest run and the latest agent execution (the multi-turn seed).
model SlackThreadSession {
  id               String   @id @default(cuid())
  organizationId   String   @db.Uuid
  bindingId        String
  channel          String
  threadTs         String // the thread root ts
  /// A thread is owned by EITHER a flow conversation (flowId/flowRunId) OR an
  /// agent conversation (agentTaskId/agentRequestId). Both flow pointers went
  /// nullable when agents became addressable from Slack; the unique key still
  /// makes one thread one conversation.
  flowId           String?
  flowRunId        String? // latest run in this thread
  agentTaskId      String?
  agentRequestId   String? // latest human-addressed request in this thread
  agentExecutionId String? // latest agent execution (conversation seed)
  status           String   @default("open") // open | closed
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([bindingId, channel, threadTs])
  @@index([flowRunId])
  @@index([agentRequestId])
  @@map("slack_thread_sessions")
}

/// Atomic dedup ledger for Slack ingress: one row per (binding, event_id or
/// trigger_id) claimed. The unique constraint IS the dedup mechanism — a
/// racing duplicate claim hits it and loses (Prisma P2002), so first-seen is
/// decided by the database, not a check-then-set read. Global across
/// instances (no Redis needed). Rows are pruned by the cron sweep once old
/// enough that Slack would no longer retry them.
model SlackProcessedEvent {
  id        String   @id @default(cuid())
  bindingId String
  dedupId   String // event_id (events) or trigger_id (slash commands)
  createdAt DateTime @default(now())

  @@unique([bindingId, dedupId])
  @@index([createdAt])
  @@map("slack_processed_events")
}

/// One normalized business activity from any connected tool. Immutable once
/// written; the durable record beneath the graph projection (Neo4j retention
/// prunes nodes — this ledger is what makes the graph rebuildable).
model ActivityEvent {
  id              String    @id @default(cuid())
  organizationId  String    @db.Uuid
  source          String // 'slack' | 'salesforce' | 'github' | ...
  actorRef        String // provider user id
  actorName       String?
  action          String // normalized verb: 'posted_message', 'changed_stage', ...
  entityType      String // 'message' | 'opportunity' | 'pull_request' | ...
  entityRef       String // provider entity id
  entityName      String?
  previousState   Json?
  newState        Json?
  participants    Json      @default("[]") // array of actor refs
  businessContext Json      @default("{}") // related account/opp/channel/repo refs
  outcome         String?
  occurredAt      DateTime // provider timestamp
  ingestedAt      DateTime  @default(now())
  ingestKind      String // 'backfill' | 'webhook' | 'sync'
  // Replay guard, unique PER ORG (a provider id from one tenant must never
  // dedupe-drop another tenant's event).
  dedupeKey       String
  indexedAt       DateTime? // null until graph indexing succeeds; re-index sweeps nulls

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, occurredAt])
  @@index([organizationId, source, action])
  @@index([organizationId, indexedAt])
  @@map("activity_events")
}

/// In-app behavior ledger (user behavior learning spec §1). Immutable rows,
/// references-only context (never raw prompt/message text). indexedAt is the
/// graph-projection gate: null until indexed, so sweeps make the graph
/// rebuildable from this ledger.
model UserEvent {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  userId         String
  kind           String // bounded list — see USER_EVENT_KINDS in src/lib/behavior/record-event.ts
  resourceType   String? // 'agent' | 'flow' | 'suggestion' | ...
  resourceId     String?
  context        Json      @default("{}")
  occurredAt     DateTime  @default(now()) @db.Timestamptz(6)
  indexedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([userId, occurredAt])
  @@index([organizationId, indexedAt])
  @@map("user_events")
}

/// Durable per-user behavior pattern (spec §3). Postgres is the source of
/// truth (the graph projection is a retrieval view). status 'dismissed'
/// permanently suppresses the slug and similar summaries.
// Platform-wide anonymized automation archetypes (intelligence phase 3).
// GLOBAL table — no organizationId by design: rows are k-anonymous aggregates
// of automation SHAPES (provider set + trigger type, platform vocabulary
// only) and are only ever written when >= MIN_ARCHETYPE_ORGS distinct orgs
// share the shape. Nothing org-, user-, or content-identifiable is stored.
model PlatformArchetype {
  id          String   @id @default(cuid())
  signature   String   @unique // "<providers sorted, '+'-joined>:<triggerType>"
  providers   Json // string[] — runtime provider vocabulary
  triggerType String // manual | schedule | signal
  orgCount    Int // distinct orgs running this shape (always >= the k-anon floor)
  flowCount   Int // qualifying flows across those orgs
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@index([orgCount])
  @@map("platform_archetypes")
}

model UserPattern {
  id              String   @id @default(cuid())
  organizationId  String   @db.Uuid
  userId          String
  slug            String // deterministic, from the miner
  kind            String // 'sequence' | 'temporal' | 'friction' | 'intent'
  summary         String
  occurrenceCount Int
  firstSeenAt     DateTime @db.Timestamptz(6)
  lastSeenAt      DateTime @db.Timestamptz(6)
  evidence        Json     @default("[]") // supporting user_event ids
  status          String   @default("open") // open | dismissed
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([organizationId, userId, status])
  @@map("user_patterns")
}

/// One quiet, evidence-cited suggestion per user at a time (spec §4).
model UserSuggestion {
  id                 String   @id @default(cuid())
  organizationId     String   @db.Uuid
  userId             String
  kind               String // 'new_flow' | 'enhancement'
  title              String
  description        String
  flowId             String? // draft flow created for new_flow suggestions
  targetType         String? // 'agent' | 'flow' (enhancements)
  targetId           String?
  sourcePatternSlugs Json     @default("[]")
  evidence           Json     @default("[]") // rendered "why this exists" lines
  /// Kind-specific payload. goal_action: { goalId, seedKey } — the goal that
  /// triggered it and the catalogue template the accept deploys.
  metadata           Json     @default("{}")
  status             String   @default("open") // open | accepted | dismissed
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, status])
  @@map("user_suggestions")
}

/// One historical backfill run for a connected source. Cursor-checkpointed so
/// a crashed/redeployed job resumes instead of re-reading completed pages.
model ActivityBackfill {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  source         String
  connectionRef  String // e.g. SlackWorkspaceConnection.id
  window         String // '90d' | '1y' | 'all'
  status         String    @default("pending") // pending | running | partial | done | failed
  cursor         String?
  eventsIngested Int       @default(0)
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, source, connectionRef])
  @@map("activity_backfills")
}

/// Deterministic, measured statistics for one recurring process, computed from
/// ActivityEvent rows (day-one-roi spec 2026-08-03). Facts only — no LLM
/// output. Volume, cadence, cycle time and rework are counted or timed from
/// observed events; handlingMinutes is the single estimated input, and the
/// table version it came from is recorded so a later revision of that table
/// cannot silently restate historical figures.
model ProcessBaseline {
  id             String @id @default(cuid())
  organizationId String @db.Uuid
  source         String
  action         String
  entityType     String

  volume               Int
  /// Observation window actually covered, not the window requested.
  windowDays           Int
  /// Median inter-event interval. Null when fewer than 2 events.
  periodDays           Float?
  distinctActors       Int
  /// Null unless the process carries state transitions.
  medianCycleTimeHours Float?
  /// Null when no entity in the process has transitions — distinct from 0,
  /// which means transitions exist and none regressed.
  reworkRate           Float?
  /// 0..1, from volume and window coverage.
  confidence           Float

  handlingTimeTableVersion Int
  /// Resolved minutes per occurrence: curated table, or the org override.
  /// Null for actions the table does not cover.
  handlingMinutes          Float?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, source, action, entityType])
  @@index([organizationId, confidence])
  @@map("process_baselines")
}

/// Durable per-organization persona (org-persona-pipeline spec 2026-07-20).
/// departmentWeights are deterministic and always present; narrative and
/// confidence stay NULL until real usage signal exists (a scan profile or
/// activity events). Postgres is the source of truth; a graph projection
/// mirrors it when NEO4J_* + VOYAGE_API_KEY are configured.
model OrganizationPersona {
  id                String   @id @default(cuid())
  organizationId    String   @unique @db.Uuid
  departmentWeights Json     @default("{}")
  narrative         String?
  confidence        Float?
  signalsSummary    Json     @default("{}")
  computedAt        DateTime @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_personas")
}

/// Atomic idempotency ledger for activity→flow dispatch: one row per
/// (event, flow) claimed. The unique constraint IS the mechanism — a racing
/// duplicate hits P2002 and loses (same pattern as SlackProcessedEvent).
model ActivityTriggerClaim {
  id        String   @id @default(cuid())
  eventId   String
  flowId    String
  createdAt DateTime @default(now())

  @@unique([eventId, flowId])
  @@index([createdAt])
  @@map("activity_trigger_claims")
}

/// A file uploaded as knowledge for an agent. We store the EXTRACTED TEXT (no
/// blob storage); the original binary is not retained. Chunks are embedded (when
/// embeddings are configured) and retrieved into the agent's context at run time.
/// A purchased (or manually granted) block of additional usage credits,
/// applied on top of the plan's monthly allowance for one UTC month.
/// Written only by the Stripe webhook (idempotent on stripeRef) or by
/// internal tooling — never by a user-facing settings write.
model CreditGrant {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  credits        Int
  /// UTC month the grant applies to, e.g. "2026-07".
  month          String
  reason         String   @default("topup")
  /// Stripe checkout session id; unique so webhook retries can't double-grant.
  stripeRef      String?  @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, month])
  @@map("credit_grants")
}

model KnowledgeDocument {
  id               String    @id @default(cuid())
  organizationId   String    @db.Uuid
  agentId          String? // the agent this knowledge belongs to (null = org-wide)
  userId           String?
  filename         String
  title            String?
  mimeType         String
  sizeBytes        Int       @default(0)
  charCount        Int       @default(0)
  // Canonical source contract. Uploads, completed runs, connected-tool
  // profiles, and normalized activity all enter retrieval through the same
  // durable document/chunk substrate.
  sourceType       String    @default("upload")
  sourceId         String?
  // 'private' = creating user, 'agent' = users who can run the attached
  // agent, 'organization' = workspace-wide distilled knowledge.
  visibility       String    @default("agent")
  // Full canonical body is encrypted with ENCRYPTION_KEY. Chunks have their
  // own encrypted copy so future migrations can drop the legacy plaintext
  // column without losing keyword/vector retrieval compatibility.
  contentEncrypted String?   @db.Text
  contentHash      String?
  provenance       Json      @default("{}")
  // workspace = retain until explicit deletion/workspace teardown;
  // zero = do not retain; expiring = expiresAt controls cleanup.
  retentionPolicy  String    @default("workspace")
  lastSyncedAt     DateTime? @db.Timestamptz(6)
  expiresAt        DateTime? @db.Timestamptz(6)
  status           String    @default("ready") // ready | failed
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, agentId])
  @@index([organizationId, userId, createdAt])
  @@index([organizationId, sourceType, lastSyncedAt])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id               String  @id @default(cuid())
  documentId       String
  organizationId   String  @db.Uuid
  agentId          String?
  ordinal          Int     @default(0)
  content          String  @db.Text
  contentEncrypted String? @db.Text
  embedding        Json? // number[] embedding, or null when embeddings are unconfigured

  /// pgvector copy of `embedding` (WS-R5). Reads/writes go through raw SQL —
  /// Prisma cannot query Unsupported columns. The Json column is legacy,
  /// kept for deploy-window safety; drop it in a future migration.
  embeddingVec Unsupported("vector(1024)")?

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, agentId])
  // HNSW index created by hand-edited migration SQL (Prisma's schema DSL has
  // no `hnsw`/`vector_cosine_ops` vocabulary); declaring it here keeps
  // `prisma migrate diff` from proposing to drop it as drift.
  @@index([embeddingVec], map: "knowledge_chunks_embedding_vec_hnsw")
  @@map("knowledge_chunks")
}

/// A user-authored skill with explicit creator, workspace, or public visibility.
/// Attached to agents by id and composed into the system prompt at run time
/// alongside built-in skills.
model SharedSkill {
  id             String   @id @default(cuid())
  name           String
  description    String   @default("")
  category       String   @default("Community")
  instructions   String   @db.Text
  tags           Json     @default("[]")
  integrations   Json     @default("[]")
  authorName     String   @default("")
  organizationId String   @db.Uuid
  userId         String?
  // private = creator only; organization = workspace members; public = all workspaces.
  visibility     String   @default("private")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Org deletion cascades community skills — an orphaned skill has no owner able to edit or retire it.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([isActive, updatedAt])
  @@index([organizationId, visibility, updatedAt])
  @@map("shared_skills")
}

enum Plan {
  TRIAL
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

/// Workspace role. ADMIN adds org-goal authoring, workspace insights, member
/// management, billing, and audited takeover of other members' work; MEMBER is
/// everything else. Deliberately two values — billing sits with admins rather
/// than a separate Owner role. Every org must keep at least one active ADMIN
/// (enforced in src/lib/server/permissions.ts, not by the database).
enum UserRole {
  ADMIN
  MEMBER
}

/// A measurable target. ownerUserId null = org goal (visible to the whole
/// org); set = personal goal (visible only to its owner). A personal goal may
/// name the org goal it supports via parentGoalId (recommendation context and
/// rollup display — never an auto-sum). riskLevel is PERSISTED so the
/// evaluator can detect transitions: only a transition emits a suggestion.
model Goal {
  id               String    @id @default(cuid())
  organizationId   String    @db.Uuid
  ownerUserId      String?
  parentGoalId     String?
  name             String
  description      String?   @db.Text
  kind             String // 'arr' | 'mrr' | 'revenue' | 'quota' | 'savings' | 'lead_gen' | 'custom_kpi'
  direction        String    @default("increase") // 'increase' | 'decrease' (savings count down)
  unit             String    @default("usd") // 'usd' | 'count' | 'percent'
  startValue       Float
  targetValue      Float
  startAt          DateTime  @default(now()) @db.Timestamptz(6)
  targetDate       DateTime  @db.Timestamptz(6)
  recurrence       String? // 'monthly' | 'quarterly' | 'yearly' | null
  status           String    @default("active") // 'active' | 'paused' | 'achieved' | 'missed' | 'archived'
  /// 'workspace' (default) — anyone in the org who can see goals may lens in.
  /// 'restricted' — only GoalMember rows and workspace admins; for everyone
  /// else the goal is ABSENT (404), never forbidden (403), because a 403
  /// confirms the goal exists and for a confidential goal that is most of the
  /// secret. Personal goals ignore this entirely: ownerUserId already restricts
  /// them, and two mechanisms for one idea is how contradictions get built.
  access           String    @default("workspace")
  riskLevel        String    @default("no_data") // 'on_track' | 'at_risk' | 'off_track' | 'no_data'
  lastEvaluatedAt  DateTime? @db.Timestamptz(6)
  /// Ordered widget layout {version:1, widgets:[{id,type,config}]}. Null =
  /// render defaultLayoutForGoal(). Invalid persisted layouts fail soft to
  /// that default in the detail renderer.
  dashboardLayout  Json?
  /// Composition shape: the kind's declared rollup config (KPI shape, weights,
  /// per-rep targets, variance tolerance, coverage threshold). Null =
  /// uncomposed; such a goal evaluates exactly as it did before composition.
  composition      Json?
  /// Per-evaluation summary { level, boundPct, derived, variancePct,
  /// reconciliation, breachedGates, missing, reasons }. Written by
  /// evaluateAndPersistGoal so the goals list renders a composition badge
  /// without an N+1 over components.
  compositionState Json?
  /// The GoalTemplate.key this goal was created from, or null for
  /// Copilot-drafted and manually-created goals. Read by the agent-bundle
  /// lookup to offer the template's curated agents; never edited after create.
  templateKey      String?
  /// User-set arbitration priority for multi-goal agents; lower = more
  /// important, null = rank automatically by risk then deadline. Any set
  /// priority outranks every unset one (see lib/goals/arbitration.ts).
  priority         Int?
  createdByUserId  String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User?              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  parent        Goal?              @relation("GoalRollup", fields: [parentGoalId], references: [id], onDelete: SetNull)
  children      Goal[]             @relation("GoalRollup")
  metrics       GoalMetric[]
  contributions GoalContribution[]
  periods       GoalPeriod[]
  recoveryPlans GoalRecoveryPlan[]
  work          GoalWork[]
  members       GoalMember[]
  runVerdicts   GoalRunVerdict[]
  agentRequests AgentRequest[]

  @@index([organizationId, status])
  @@index([organizationId, ownerUserId, status])
  @@map("goals")
}

/// Who may see a goal whose access is 'restricted'. Absent for 'workspace'
/// goals — membership is only ever consulted when access = 'restricted', so an
/// unrestricted goal needs no rows here.
model GoalMember {
  goalId    String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([goalId, userId])
  @@index([userId])
  @@map("goal_members")
}

/// One unit of work an agent or flow did toward a goal — one row per SUBJECT
/// (deal, lead, account), never one per run. `disposition` records what a
/// human did with it; `outcome` records whether it landed. They are separate
/// on purpose: "a person used the draft" and "it moved the goal" are different
/// facts, and merging them would make the funnel unreadable.
///
/// One PENDING item per subject is enforced by a partial unique index
/// (migration-managed, not expressible here — same discipline as
/// goal_recovery_plans_one_open_per_goal).
model GoalWork {
  id             String @id @default(cuid())
  organizationId String @db.Uuid
  goalId         String

  /// Provenance. runId is an AgentExecution.id or FlowRun.id depending on
  /// resourceType — deliberately not an FK, because work outlives run pruning.
  resourceType String // 'agent' | 'flow'
  resourceId   String
  runId        String?

  subject    String
  /// Stable external id. The dedupe key; null means this row is never deduped.
  subjectRef String?
  produced   String
  body       String? @db.Text
  bodyFormat String  @default("markdown") // 'markdown' | 'html'

  /// Flat, untyped features the agent used to pick this subject. The miner
  /// reads numbers and short strings and ignores anything else — a schema
  /// over this would be a taxonomy nobody maintains.
  signals        Json?
  /// Set when the agent works something an active rule would have suppressed.
  /// The entire falsification mechanism: a rule that suppresses a category
  /// destroys the evidence that would revise it, and these probes are that
  /// evidence. Deliberately not an FK — a retired rule's probes stay readable.
  probeForRuleId String?

  /// User.id is a cuid — supabaseId is the uuid — so user references here are
  /// plain text, matching Goal.ownerUserId and Goal.createdByUserId.
  assigneeUserId String?

  disposition   String    @default("pending") // pending | used | edited | skipped
  dispositionBy String?
  dispositionAt DateTime? @db.Timestamptz(6)
  /// The closed vocabulary value. Kept separate from skipNote so reasons stay
  /// countable without an LLM — that countability is what makes rules derivable.
  skipReason    String?
  /// Free text, offered only when skipReason is 'other'. `other` is exactly
  /// where the five fixed reasons failed, so it is the one case where the
  /// words matter more than the count.
  skipNote      String?

  outcome       String    @default("unknown") // unknown | worked | no_response | failed
  outcomeSource String? // 'agent' | 'human'
  outcomeNote   String?
  outcomeAt     DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goal         Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([organizationId, goalId, disposition])
  @@index([goalId, assigneeUserId, disposition])
  @@index([goalId, resourceId])
  @@index([probeForRuleId])
  @@map("goal_work")
}

/// A targeting lesson learned from what humans did with an agent's work.
///
/// Level 1: goalId + resourceId set — this agent, on this goal.
/// Level 2: seedKey set, goalId and resourceId null — every deployment of
/// this seed in this org, promoted when the lesson repeats on 2+ goals.
///
/// `statement` is prose the agent applies, NOT a predicate code enforces: the
/// agent is the only thing that knows a subject's signals BEFORE producing,
/// and enforcing in code would mean producing first and discarding after —
/// wasting exactly the work the rule exists to prevent. `signal` exists only
/// to dedupe and group rules for display.
model GoalWorkRule {
  id             String @id @default(cuid())
  organizationId String @db.Uuid

  goalId     String?
  resourceId String?
  seedKey    String?

  signal    String
  statement String
  /// The same conclusion phrased as an observation for a human. Null on rules
  /// learned before this shipped; the strip falls back to `statement`, so no
  /// backfill is needed.
  finding   String?

  skippedCount  Int
  totalCount    Int
  topSkipReason String?

  status      String @default("active") // active | retired
  /// Share of suppressed subjects the agent must work anyway, as probes.
  /// Without it a rule can never be disproved.
  exploreRate Float  @default(0.2)

  learnedAt       DateTime  @default(now()) @db.Timestamptz(6)
  retiredAt       DateTime? @db.Timestamptz(6)
  retiredReason   String? // 'probes_contradicted' | 'unprobed' | 'revoked'
  /// Set when a human revoked it, so a rule someone deliberately turned off is
  /// distinguishable from one the evidence killed.
  revokedByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, goalId, status])
  @@index([organizationId, seedKey, status])
  @@map("goal_work_rules")
}

/// Immutable settlement history for a recurring goal window. The Goal row
/// advances in place; periods preserve the frozen target and outcome.
model GoalPeriod {
  id                        String   @id @default(cuid())
  organizationId            String   @db.Uuid
  goalId                    String
  periodStart               DateTime @db.Timestamptz(6)
  periodEnd                 DateTime @db.Timestamptz(6)
  startValue                Float
  targetValue               Float
  finalValue                Float
  outcome                   String // 'achieved' | 'missed'
  /// Component values that decided this settlement, frozen at settlement time.
  compositionSnapshot       Json?
  /// Read-vs-derived headline variance at settlement, in percent.
  reconciliationVariancePct Float?
  createdAt                 DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goal         Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([organizationId, goalId, periodEnd])
  @@map("goal_periods")
}

/// Binding of a goal to a tracked series. A goal may have several: exactly
/// one role='primary' drives evaluation, and supporting metrics feed widgets.
/// The partial unique index enforcing one primary is migration-managed.
model GoalMetric {
  id                   String    @id @default(cuid())
  organizationId       String    @db.Uuid
  goalId               String
  role                 String    @default("primary") // 'primary' | 'supporting' | 'component'
  /// Component slot within the goal's composition — 'new_arr', 'stage:2',
  /// 'pipeline_coverage', 'driver:aws'. NULL for primary/supporting metrics;
  /// NULLs are distinct in Postgres unique indexes so they never collide.
  slot                 String?
  label                String?
  unit                 String? // null = inherit the goal's unit
  source               String // 'stripe' | 'hubspot' | 'salesforce' | 'google_sheets' | 'postgres' | 'url' | 'slack_assisted' | 'gmail_assisted' | 'manual'
  metricKey            String // e.g. 'stripe.mrr' | 'hubspot.pipeline_value' | 'sheets.range'
  connectionRef        String?
  config               Json      @default("{}")
  refreshIntervalHours Int       @default(24)
  lastSyncAt           DateTime? @db.Timestamptz(6)
  lastError            String?   @db.Text
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goal         Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  datapoints   MetricDatapoint[]

  @@unique([goalId, slot])
  @@index([goalId])
  @@index([organizationId, source])
  @@map("goal_metrics")
}

/// Time-series reading. bucketKey is the UTC day 'YYYY-MM-DD' of capturedAt —
/// re-syncs upsert on (goalMetricId, bucketKey) and never double-write (the
/// activity-ledger dedupe discipline).
model MetricDatapoint {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  goalMetricId   String
  value          Float
  capturedAt     DateTime @db.Timestamptz(6)
  bucketKey      String
  origin         String   @default("sync") // 'sync' | 'manual' | 'backfill' | 'assisted'
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goalMetric   GoalMetric   @relation(fields: [goalMetricId], references: [id], onDelete: Cascade)

  @@unique([goalMetricId, bucketKey])
  @@index([organizationId, goalMetricId, capturedAt])
  @@map("metric_datapoints")
}

/// Attribution link (proof layer): an automation that exists — or was
/// enlisted — to advance a goal. Created automatically when a goal suggestion
/// is provisioned, or manually from the goal page. Impact is computed by
/// joining FlowRun/AgentExecution through these links; runs that started
/// before createdAt never count.
model GoalContribution {
  id                          String   @id @default(cuid())
  organizationId              String   @db.Uuid
  goalId                      String
  resourceType                String // 'flow' | 'agent'
  resourceId                  String
  origin                      String // 'suggestion' | 'manual'
  seedKey                     String?
  estimatedMinutesSavedPerRun Int      @default(30)
  /// True ONLY when a human changed the estimate (PATCH contributions).
  /// Calibration counts exactly these rows — provision-time calibrated
  /// defaults must never feed back into the median (self-reinforcement).
  estimateEdited              Boolean  @default(false)
  createdAt                   DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goal         Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, resourceType, resourceId])
  @@index([organizationId, goalId])
  @@index([seedKey])
  @@map("goal_contributions")
}

/// The reflection pass's per-run judgment of whether a run advanced a linked
/// goal. `runId` is deliberately not an FK — verdicts outlive run pruning
/// (same reasoning as GoalWork.runId). Consumed by recovery-plan evidence and
/// the stalled-agent escalation (lib/goals/verdicts.ts).
model GoalRunVerdict {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  goalId         String
  resourceType   String // 'agent' | 'flow'
  resourceId     String
  runId          String
  verdict        String // 'advanced' | 'no_change' | 'unclear' | 'counterproductive'
  evidence       String   @default("") @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goal         Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([organizationId, goalId, createdAt])
  @@index([organizationId, goalId, resourceId, createdAt])
  @@map("goal_run_verdicts")
}

/// AI-generated recovery plan for a goal whose risk worsened. At most one
/// 'open' plan per goal — enforced by a migration-managed partial unique
/// index (same discipline as GoalMetric's one-primary index). The
/// UserSuggestion emitted alongside is the alert vehicle; this row is the
/// content the goal dashboard renders.
model GoalRecoveryPlan {
  id               String    @id @default(cuid())
  organizationId   String    @db.Uuid
  goalId           String
  status           String    @default("open") // 'open' | 'resolved' | 'superseded' | 'dismissed'
  triggerRiskLevel String // 'at_risk' | 'off_track'
  diagnosis        String    @db.Text
  /// Measured-fact evidence lines frozen at generation time (string[]).
  evidence         Json      @default("[]")
  /// { ms: number } — latency of the generating call.
  modelMeta        Json      @default("{}")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt       DateTime? @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goal         Goal                 @relation(fields: [goalId], references: [id], onDelete: Cascade)
  actions      GoalRecoveryAction[]

  @@index([organizationId, goalId, status])
  @@map("goal_recovery_plans")
}

/// One independently actionable step of a recovery plan. payload by kind:
/// connect_tool {source}, launch_agent {seedKey}, manual_step {}.
/// resultRef records what accepting produced (AgentTask id / flow id).
model GoalRecoveryAction {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  planId         String
  kind           String // 'connect_tool' | 'launch_agent' | 'manual_step'
  title          String
  rationale      String    @db.Text
  payload        Json      @default("{}")
  rank           Int       @default(0)
  status         String    @default("proposed") // 'proposed' | 'accepted' | 'done' | 'dismissed'
  resultRef      String?
  acceptedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         GoalRecoveryPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("goal_recovery_actions")
}

/// Global k-anonymous calibration for a catalogue seed's manual-time estimate.
/// No organization identity or individual estimate is stored.
model TemplateEstimateCalibration {
  seedKey       String   @id
  medianMinutes Int
  orgCount      Int
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@map("template_estimate_calibrations")
}

/// Global k-anonymous outcome counts by goal kind. Values and org identities
/// never cross workspace boundaries.
model GoalBenchmark {
  kind          String   @id
  orgCount      Int
  settledCount  Int
  achievedCount Int
  topSeedKeys   Json     @default("[]")
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@map("goal_benchmarks")
}

/// Global k-anonymous template adoption counts, keyed by template key
/// ("seed:<seedKey>" | "db:<templateId>"). Rows are k-anonymous BY
/// CONSTRUCTION: a key is upserted only when >= MIN_ADOPTION_ORGS distinct
/// orgs have deployed it, and stored rows falling below the floor are deleted
/// on the next sweep. Only counts are stored — never org ids, user ids, or
/// deployed resource ids.
model TemplateAdoption {
  templateKey String   @id
  deploys     Int
  surviving   Int
  orgCount    Int
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("template_adoptions")
}
