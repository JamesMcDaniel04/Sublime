# Minimal worker container for SprintIQ queue processing
# Connects to Upstash Redis and processes BullMQ jobs
#
# node:22 satisfies camera-controls' engines (>=22) within the repo-wide
# >=20 <23 range.
FROM node:22-alpine

WORKDIR /app

# Copy package files and prisma. .npmrc is REQUIRED: the lockfile was
# generated with legacy-peer-deps=true, so `npm ci` without that setting
# computes a different tree (auto-installed peers like webpack) and fails
# with "lock file out of sync".
COPY package*.json .npmrc ./
COPY tsconfig.json ./
COPY prisma ./prisma/

# Install all dependencies (ts-node, tsconfig-paths are dev deps)
RUN npm ci && npm cache clean --force

# Copy source
COPY src ./src/

# Generate Prisma client
RUN npx prisma generate

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:3002/health || exit 1

EXPOSE 3002

# Run the single canonical worker runtime
CMD ["npm", "run", "worker:start"]
