{
  "name": "sublime-studio",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker:dev\"",
    "build": "prisma generate && node scripts/vercel-migrate.mjs && next build && npm run bundle:check",
    "start": "next start",
    "worker:dev": "tsx watch src/lib/workers/runtime.ts",
    "worker:start": "tsx src/lib/workers/runtime.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint . --max-warnings 89",
    "check": "npm run typecheck && npm run lint && npm run audit:prod && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "check:auth": "node scripts/check-auth-hardening.mjs",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "TSX_TSCONFIG_PATH=tsconfig.test.json tsx --test --test-concurrency=4 $(find src -type f \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -path '*__tests__*')",
    "test:e2e": "playwright test",
    "eval": "tsx --test $(find src/lib/eval -type f -name '*.test.ts' -path '*__tests__*')"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@nangohq/frontend": "^0.71.4",
    "@nangohq/node": "^0.71.4",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-pdf/renderer": "^4.8.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@types/web-push": "^3.6.4",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.11.3",
    "amqplib": "^2.0.1",
    "bullmq": "^5.58.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "fastify": "^5.12.1",
    "ioredis": "^5.4.2",
    "kafkajs": "^2.2.4",
    "lucide-react": "^0.513.0",
    "mammoth": "^1.12.1",
    "motion": "^12.42.2",
    "mqtt": "^5.15.2",
    "neo4j-driver": "^6.2.0",
    "next": "^15.5.19",
    "next-themes": "^0.4.6",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "pyodide": "^314.0.5",
    "quickjs-emscripten": "^0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.3",
    "sonner": "^2.0.8",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tsx": "^4.23.12",
    "undici": "^7.29.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/amqplib": "^0.10.8",
    "@types/dagre": "^0.7.54",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.19",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
