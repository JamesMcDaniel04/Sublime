# Web and authentication
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Scheduling — REQUIRED for any agent/flow schedule to ever fire.
# vercel.json runs /api/cron/dispatch every 15 minutes; that route refuses to run
# without this secret (it fails closed rather than letting anyone trigger it). If
# this is unset, schedules still show as "active" in the UI and silently never
# run. Generate with: openssl rand -hex 32
CRON_SECRET=

# Data and worker
# Serverless (Vercel): DATABASE_URL = Supabase Transaction pooler (port 6543) with
# ?pgbouncer=true&connection_limit=1. DIRECT_URL = Session pooler (5432) for migrations.
# (assertServerEnv fails production boot without pgbouncer=true&connection_limit —
# escape hatch for a deliberate direct connection: DATABASE_URL_UNPOOLED_OK=true.)
#
# WORKER (Render): do NOT reuse the serverless URL — one worker process runs
# (2×agent + flow + backfill) concurrent jobs against one Prisma pool, so its
# DATABASE_URL needs connection_limit >= that total (32 at the defaults), e.g.
# the Session pooler: postgresql://USER:PASSWORD@HOST:5432/DB?connection_limit=40
# assertWorkerEnv warns at boot when this is mis-sized.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DB?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DB
REDIS_URL=redis://localhost:6379
AGENT_WORKER_CONCURRENCY=10
WORKER_PORT=3002

# Agent runtime — configure Anthropic, Qwen, or both. At least one provider is
# required. Claude is the default; Qwen uses DashScope's Anthropic-compatible
# Messages endpoint and acts as the automatic fallback when configured.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
SUMMARY_MODEL=claude-haiku-4-5
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen-3.7
AGENT_MAX_TURNS=16
# Optional: cap total (input+output) tokens per org per UTC month. 0/unset = unlimited.
AGENT_MONTHLY_TOKEN_LIMIT=0

# Password signup: set 'false' to force SSO/invite-only (production).
AUTH_ALLOW_PASSWORD=
# Every accepted signup joins the original workspace automatically. Disable
# signup in Supabase (and set AUTH_ALLOW_PASSWORD=false) for invite-only mode.
# Server-only key required for invitations and global session revocation.
SUPABASE_SERVICE_ROLE_KEY=

# Bot protection — Cloudflare Turnstile (dash.cloudflare.com → Turnstile).
# Unset = every captcha check is a clean no-op, which is the correct local
# default. Set BOTH in production, AND enable Turnstile in the Supabase Auth
# dashboard: signup/login/recovery go browser → Supabase directly, so only
# Supabase can verify those tokens. The site key is public by design (it is
# rendered into the widget); the secret key must never reach the client.
# Verify with: npm run check:auth
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Graph-RAG brain (correlates workspace signals + integration/MCP data + prior
# runs to give agents and the assistant richer context). All optional and
# gated: with none set, RAG is a clean no-op and nothing changes.
# Embeddings — Voyage AI (dashboard.voyageai.com → API Keys, pa-...).
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=
# Optional cross-encoder rerank pass on graph-RAG retrieval (adds one Voyage
# API call per retrieval). e.g. rerank-2.5-lite. Empty = cosine order only.
VOYAGE_RERANK_MODEL=
# Graph store — Neo4j (AuraDB or self-hosted). All three required for a durable
# graph; without them the store falls back to per-process in-memory.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Nango connected accounts (Connect UI + backend SDK)
# Environment secret key from the Nango dashboard (Environment settings).
NANGO_SECRET_KEY=
# Optional — self-hosted or regional Nango API host. Leave blank for Nango Cloud.
NANGO_HOST=
# Optional — self-hosted Connect UI base URL. Leave blank for https://connect.nango.dev.
NEXT_PUBLIC_NANGO_CONNECT_URL=

# Upload malware scanning — optional HTTP scanner (e.g. a ClamAV REST sidecar).
# POST bytes, expect {"infected": boolean, "viruses"?: string[]}.
# Unset = uploads are accepted after signature and size checks with no AV pass.
# Set this in any deployment that accepts files from untrusted users: the
# extractor hands uploaded bytes to pdf-parse and mammoth in-process.
# Fails CLOSED — an unreachable scanner rejects the upload rather than waving it
# through, so a scanner outage costs knowledge ingestion and nothing else.
UPLOAD_SCANNER_URL=

# Secrets at rest — encrypts MCP connection and integration API keys.
# Required in production. Local development falls back to reversible base64
# only so the app can boot without production secrets.
ENCRYPTION_KEY=

# Granola meeting notes — optional global fallback API key (grn_...).
# Each workspace can save its own key on the integrations page, which takes
# precedence over this value.

# Web push (browser notifications) — optional; in-app notifications work without it.
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Voice huddle TURN relay (optional — STUN-only without it; symmetric-NAT pairs
# need TURN to connect). Shared-secret mode mints time-limited credentials.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_STATIC_USERNAME=
TURN_STATIC_CREDENTIAL=

# Stripe billing (live keys in deploy env; test keys fine for development)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_INDIVIDUAL=price_xxx
STRIPE_PRICE_TEAM=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
