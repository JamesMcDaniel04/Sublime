generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  // Workspace avatar shown in the org switcher — a small data URL (client
  // resizes to 128px before upload) so no external storage is required.
  logoUrl   String?
  plan      Plan     @default(TRIAL)
  // Freeform org-level settings grab-bag (e.g. `disableConnectionScans`).
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  users                     User[]
  agents                    AgentTask[]
  executions                AgentExecution[]
  templates                 AgentTemplate[]
  integrations              Integration[]
  mcpAgents                 MCPAgent[]
  notifications             Notification[]
  mcpConnections            McpConnection[]
  nangoConnections          NangoConnection[]
  integrationSecrets        IntegrationSecret[]
  activityEvents            ActivityEvent[]
  activityBackfills         ActivityBackfill[]
  auditEvents               AuditEvent[]
  agentMemories             AgentMemory[]
  flowVersions              FlowVersion[]
  flows                     Flow[]
  pushSubscriptions         PushSubscription[]
  knowledgeDocuments        KnowledgeDocument[]
  sharedSkills              SharedSkill[]
  invitations               OrganizationInvitation[]
  flowCollaborators         FlowCollaborator[]
  slackWorkspaceConnections SlackWorkspaceConnection[]
  slackThreadSessions       SlackThreadSession[]

  @@map("organizations")
}

model User {
  id             String    @id @default(cuid())
  supabaseId     String    @unique @db.Uuid
  email          String?
  name           String?
  imageUrl       String?
  role           UserRole  @default(USER)
  organizationId String?   @db.Uuid
  isActive       Boolean   @default(true)
  lastSeenAt     DateTime? @db.Timestamptz(6)
  metadata       Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions         AgentExecution[]
  templates          AgentTemplate[]
  integrations       Integration[]
  mcpAgents          MCPAgent[]
  ownedAgents        AgentTask[]
  mcpConnections     McpConnection[]
  flowCollaborations FlowCollaborator[] @relation("FlowCollaboratorUser")
  flowInvitesSent    FlowCollaborator[] @relation("FlowCollaboratorInviter")

  @@index([organizationId])
  @@map("users")
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String       @db.Uuid
  email          String
  role           UserRole     @default(USER)
  invitedById    String?
  expiresAt      DateTime     @db.Timestamptz(6)
  acceptedAt     DateTime?    @db.Timestamptz(6)
  revokedAt      DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

model AgentTask {
  id             String    @id @default(cuid())
  agentType      String    @default("CUSTOM")
  description    String    @db.Text
  objective      String    @db.Text
  goal           String?   @db.Text
  schedule       Json      @default("{}")
  status         String    @default("ACTIVE")
  folder         String?
  visibility     String    @default("private")
  organizationId String    @db.Uuid
  userId         String?
  metadata       Json?
  lastExecutedAt DateTime?
  executionCount Int       @default(0)
  lastResult     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  executions          AgentExecution[]
  chatMessages        AgentChatMessage[]
  chatSessions        AgentChatSession[]
  connectors          AgentConnector[]
  memories            AgentMemory[]

  @@index([organizationId, status])
  @@index([userId])
  @@map("agent_tasks")
}

/// Typed binding between an agent and a connector it uses. Replaces matching
/// fuzzy strings against the agent's `metadata.integrations` JSON with real
/// rows: a canonical connector key, its plane (kind), and — for a per-org MCP
/// connection — a foreign key with referential integrity (deleting the
/// connection nulls the binding instead of leaving a dangling string).
model AgentConnector {
  id              String   @id @default(cuid())
  agentTaskId     String
  organizationId  String   @db.Uuid
  /// Canonical selection key (registry key, Klavis agentType, or connection name).
  connectorKey    String
  /// Plane: 'builtin' | 'nango' | 'klavis' | 'mcp' | 'external'.
  kind            String   @default("external")
  /// Optional FK to a specific per-org MCP connection this binding targets.
  mcpConnectionId String?
  config          Json     @default("{}")
  createdAt       DateTime @default(now())

  agentTask     AgentTask      @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  mcpConnection McpConnection? @relation(fields: [mcpConnectionId], references: [id], onDelete: SetNull)

  @@unique([agentTaskId, connectorKey])
  @@index([organizationId])
  @@index([mcpConnectionId])
  @@map("agent_connectors")
}

/// Durable, agent-scoped memory: answers to clarifying questions, learnings
/// distilled from executions, and proactive suggestions. Retrieved by kind +
/// status to ground future runs without re-asking or re-deriving.
model AgentMemory {
  id             String  @id @default(cuid())
  organizationId String  @db.Uuid
  agentId        String
  kind           String // 'user_answer' | 'learning' | 'suggestion'
  title          String
  content        String  @db.Text
  question       String? @db.Text
  embedding      Json?

  /// pgvector copy of `embedding` (WS-R5). Reads/writes go through raw SQL —
  /// Prisma cannot query Unsupported columns. The Json column is legacy,
  /// kept for deploy-window safety; drop it in a future migration.
  embeddingVec Unsupported("vector(1024)")?

  sourceExecutionId String?
  /// Stable key `<plane>:<connectionRef>` identifying the connection this
  /// memory was distilled from (e.g. `mcp:cmcpconn123`), set at save time by
  /// the connection scan. Nullable: only scan-derived learnings carry it —
  /// other memory kinds (user_answer, agent-authored suggestions) leave it
  /// null. Powers a precise purge query when a connection is disconnected,
  /// instead of matching against title/content strings.
  sourceRef         String?
  status            String    @default("open") // 'open' | 'dismissed' | 'superseded'
  timesUsed         Int       @default(0)
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        AgentTask    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([organizationId, agentId, kind, status])
  @@index([organizationId, sourceRef])
  // HNSW index created by hand-edited migration SQL (Prisma's schema DSL has
  // no `hnsw`/`vector_cosine_ops` vocabulary); declaring it here keeps
  // `prisma migrate diff` from proposing to drop it as drift.
  @@index([embeddingVec], map: "agent_memories_embedding_vec_hnsw")
  @@map("agent_memories")
}

// Agent-scoped assistant chat (persistent per agent + user, not per execution).
// Additive: new table only. `metadata` carries assistant proposals and their
// applied-at marker, mirroring the JSON grab-bag pattern used elsewhere.
model AgentChatMessage {
  id             String   @id @default(cuid())
  agentTaskId    String
  organizationId String   @db.Uuid
  userId         String
  // Groups messages into a conversation. Nullable so pre-existing flat threads
  // (before sessions) read as one implicit "Earlier conversation".
  sessionId      String?
  role           String
  content        String   @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())

  agentTask AgentTask         @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  session   AgentChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([agentTaskId, userId, createdAt])
  @@index([sessionId, createdAt])
  @@map("agent_chat_messages")
}

// A single assistant conversation for one agent + user. Multiple sessions per
// agent give users a "new chat" and a browsable history, scoped per agent.
model AgentChatSession {
  id             String   @id @default(cuid())
  agentTaskId    String
  organizationId String   @db.Uuid
  userId         String
  // Auto-derived from the first user message; null until the first message.
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agentTask AgentTask          @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  messages  AgentChatMessage[]

  @@index([agentTaskId, userId, updatedAt])
  @@map("agent_chat_sessions")
}

model AgentExecution {
  id              String    @id @default(cuid())
  agentType       String
  agentTemplateId String?
  agentTaskId     String?
  // Replay/duplicate guard for externally triggered runs.
  idempotencyKey  String?
  status          String    @default("pending")
  input           Json
  output          Json?
  error           String?
  executionTime   Int?      @default(0)
  trigger         Json
  metadata        Json?
  model           String?
  transcript      Json?
  inputTokens     Int       @default(0)
  outputTokens    Int       @default(0)
  userId          String
  organizationId  String    @db.Uuid
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentTemplate AgentTemplate?     @relation(fields: [agentTemplateId], references: [id], onDelete: SetNull)
  agentTask     AgentTask?         @relation(fields: [agentTaskId], references: [id], onDelete: SetNull)
  workflowSteps WorkflowStep[]
  events        WorkflowEvent[]
  messages      ExecutionMessage[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, startedAt])
  @@index([agentTaskId])
  @@map("agent_executions")
}

model ExecutionMessage {
  id          String   @id @default(cuid())
  executionId String
  role        String
  content     String   @db.Text
  createdAt   DateTime @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@map("execution_messages")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  userId         String?
  type           String
  level          String    @default("info")
  title          String
  body           String?   @db.Text
  agentTaskId    String?
  executionId    String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  organizationId String   @db.Uuid
  endpoint       String   @unique @db.Text
  p256dh         String   @db.Text
  auth           String   @db.Text
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model WorkflowStep {
  id          String    @id @default(cuid())
  executionId String
  node        String
  status      String
  input       Json      @default("{}")
  output      Json?
  error       Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  execution AgentExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  events    WorkflowEvent[]

  @@index([executionId, createdAt])
  @@map("workflow_steps")
}

model WorkflowEvent {
  id          String   @id @default(cuid())
  executionId String
  stepId      String?
  kind        String
  payload     Json?
  ts          DateTime @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step      WorkflowStep?  @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([executionId, ts])
  @@map("workflow_events")
}

// Append-only audit trail of consequential actions (tool writes, config
// changes, connections, approvals). Never updated or deleted in normal
// operation; exportable per org for enterprise compliance.
model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  actorUserId    String?
  actorKind      String   @default("user") // 'user' | 'agent' | 'system'
  action         String // e.g. 'tool.write', 'agent.config_changed'
  resourceType   String?
  resourceId     String?
  tool           String?
  executionId    String?
  // Hash (not contents) of the payload — proves what happened without storing
  // potentially sensitive tool arguments in the audit row.
  payloadHash    String?
  detail         Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@map("audit_events")
}

model AgentTemplate {
  id             String   @id @default(cuid())
  name           String
  description    String?  @db.Text
  type           String
  configuration  Json?
  isActive       Boolean  @default(true)
  schedule       String?
  priority       String   @default("MEDIUM")
  metadata       Json?
  userId         String
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AgentExecution[]

  @@index([organizationId, isActive])
  @@map("agent_templates")
}

model Integration {
  id             String    @id @default(cuid())
  userId         String
  organizationId String    @db.Uuid
  provider       String
  expiresAt      DateTime? @db.Timestamptz(6)
  scopes         String[]  @default([])
  status         String    @default("connected")
  failCount      Int       @default(0)
  lastError      String?   @db.Text
  metadata       Json      @default("{}")
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([organizationId, provider])
  @@map("integrations")
}

model MCPAgent {
  id             String   @id @default(cuid())
  userId         String
  organizationId String   @db.Uuid
  name           String
  agentType      String
  description    String?
  mcpServerUrl   String
  isActive       Boolean  @default(false)
  configuration  Json     @default("{}")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, agentType])
  @@map("mcp_agents")
}

model McpConnection {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  // Personal connection when set (e.g. a per-user MCP row);
  // null = org-shared server added via the connections page.
  userId         String?
  // Platform-managed provider slug; null = user-added server.
  provider       String?
  name           String
  description    String?
  serverUrl      String
  authType       String    @default("none") // 'none' | 'api_key' | 'oauth2'
  authConfig     Json      @default("{}") // encrypted secret blob + non-secret fields
  isActive       Boolean   @default(true)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentBindings AgentConnector[]

  @@unique([organizationId, userId, provider])
  @@index([organizationId, isActive])
  @@index([organizationId, userId, isActive])
  @@map("mcp_connections")
}

// Mirror of a Nango connected account, scoped per-organization. Nango owns
// the credentials; we only persist connection ids and health for listing.
model NangoConnection {
  id                String   @id @default(cuid())
  organizationId    String   @db.Uuid
  userId            String?
  connectionId      String
  providerConfigKey String
  provider          String?
  status            String   @default("connected")
  lastError         String?  @db.Text
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, connectionId])
  @@index([organizationId, providerConfigKey])
  @@index([organizationId, userId, status])
  @@map("nango_connections")
}

// Per-organization secret for built-in integrations (e.g. the Granola API
// key). authConfig holds the encrypted blob produced by buildAuthConfig().
model IntegrationSecret {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  provider       String
  authType       String   @default("api_key") // 'none' | 'api_key' | 'oauth2'
  authConfig     Json     @default("{}") // encrypted secret blob + non-secret fields
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId, isActive])
  @@map("integration_secrets")
}

/// A visual agent pipeline: a graph of steps, each running a workspace agent
/// via runAgentExecution. Distinct from WorkflowStep/WorkflowEvent (those are a
/// single agent's internal tool-call trace). See docs/superpowers/specs.
model Flow {
  id                          String   @id @default(cuid())
  name                        String
  description                 String   @default("")
  status                      String   @default("DRAFT") // DRAFT | ACTIVE | DISABLED
  trigger                     Json     @default("{}") // { type: 'manual'|'schedule'|'signal', ... }
  graph                       Json     @default("{}") // working draft: { nodes, edges }
  publishedGraph              Json? // the live version scheduled/triggered runs execute
  version                     Int      @default(1) // bumped on each publish
  visibility                  String   @default("private")
  organizationId              String   @db.Uuid
  userId                      String?
  // Freeform per-flow metadata grab-bag (e.g. behavioral-intelligence provenance).
  metadata                    Json?
  // Monotonic sequencer for durable Flow Jam graph patches.
  collaborationRevision       Int      @default(0)
  // Rotates the private Realtime topic whenever the collaborator allow-list changes.
  collaborationAccessRevision Int      @default(0)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs          FlowRun[]
  versions      FlowVersion[]
  collaborators FlowCollaborator[]

  @@index([organizationId, updatedAt])
  @@map("flows")
}

/// Explicit per-flow edit access. Workspace membership alone never exposes a
/// personal flow; the owner must invite each collaborator through Flow Jam.
model FlowCollaborator {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  userId         String
  invitedById    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("FlowCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("FlowCollaboratorInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([flowId, userId])
  @@index([organizationId, userId])
  @@map("flow_collaborators")
}

model FlowVersion {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  version        Int
  graph          Json
  trigger        Json
  note           String?
  publishedAt    DateTime @default(now())
  publishedBy    String?

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([flowId, version])
  @@index([organizationId, flowId])
  @@map("flow_versions")
}

model FlowRun {
  id              String    @id @default(cuid())
  flowId          String
  status          String    @default("running") // running | succeeded | failed | waiting
  trigger         Json      @default("{}")
  input           Json      @default("{}")
  output          Json?
  error           String?
  wakeAt          DateTime?
  webhookResponse Json?
  graphSnapshot   Json? // the graph definition this run executed against
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  organizationId  String    @db.Uuid
  userId          String?

  flow  Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  steps FlowRunStep[]

  @@index([flowId, startedAt])
  @@index([status, wakeAt])
  @@map("flow_runs")
}

model FlowRunStep {
  id               String    @id @default(cuid())
  flowRunId        String
  nodeId           String
  agentExecutionId String?
  childFlowRunId   String? // subflow step: the child FlowRun this step ran
  iterationPath    String? // dot-joined 0-based loop indices ("0", "0.2" nested) disambiguating a loop-body step across iterations; null outside any loop body
  order            Int       @default(0)
  status           String    @default("queued") // queued | running | succeeded | failed | skipped | waiting
  input            Json      @default("{}")
  output           Json?
  error            String?
  startedAt        DateTime?
  finishedAt       DateTime?

  run FlowRun @relation(fields: [flowRunId], references: [id], onDelete: Cascade)

  @@index([flowRunId, order])
  @@map("flow_run_steps")
}

/// Per-org Slack bot binding: one row per (org, Slack workspace). botToken and
/// signingSecret hold {"value": "<encryptSecret payload>"} — never plaintext.
model SlackWorkspaceConnection {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  teamId         String // Slack workspace id (T…), captured from auth.test
  teamName       String?
  botUserId      String // U… — the bot's own user id, for echo-guarding
  botToken       Json // encrypted at rest (secrets.ts shape)
  signingSecret  Json // encrypted at rest
  status         String   @default("active") // active | error | revoked
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, teamId])
  @@map("slack_workspace_connections")
}

/// One Slack thread ↔ one flow conversation. Keyed by the reply thread; tracks
/// the latest run and the latest agent execution (the multi-turn seed).
model SlackThreadSession {
  id               String   @id @default(cuid())
  organizationId   String   @db.Uuid
  bindingId        String
  channel          String
  threadTs         String // the thread root ts
  flowId           String
  flowRunId        String // latest run in this thread
  agentExecutionId String? // latest agent execution (conversation seed)
  status           String   @default("open") // open | closed
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([bindingId, channel, threadTs])
  @@index([flowRunId])
  @@map("slack_thread_sessions")
}

/// Atomic dedup ledger for Slack ingress: one row per (binding, event_id or
/// trigger_id) claimed. The unique constraint IS the dedup mechanism — a
/// racing duplicate claim hits it and loses (Prisma P2002), so first-seen is
/// decided by the database, not a check-then-set read. Global across
/// instances (no Redis needed). Rows are pruned by the cron sweep once old
/// enough that Slack would no longer retry them.
model SlackProcessedEvent {
  id        String   @id @default(cuid())
  bindingId String
  dedupId   String // event_id (events) or trigger_id (slash commands)
  createdAt DateTime @default(now())

  @@unique([bindingId, dedupId])
  @@index([createdAt])
  @@map("slack_processed_events")
}

/// One normalized business activity from any connected tool. Immutable once
/// written; the durable record beneath the graph projection (Neo4j retention
/// prunes nodes — this ledger is what makes the graph rebuildable).
model ActivityEvent {
  id              String    @id @default(cuid())
  organizationId  String    @db.Uuid
  source          String // 'slack' | 'salesforce' | 'github' | ...
  actorRef        String // provider user id
  actorName       String?
  action          String // normalized verb: 'posted_message', 'changed_stage', ...
  entityType      String // 'message' | 'opportunity' | 'pull_request' | ...
  entityRef       String // provider entity id
  entityName      String?
  previousState   Json?
  newState        Json?
  participants    Json      @default("[]") // array of actor refs
  businessContext Json      @default("{}") // related account/opp/channel/repo refs
  outcome         String?
  occurredAt      DateTime // provider timestamp
  ingestedAt      DateTime  @default(now())
  ingestKind      String // 'backfill' | 'webhook' | 'sync'
  // Replay guard, unique PER ORG (a provider id from one tenant must never
  // dedupe-drop another tenant's event).
  dedupeKey       String
  indexedAt       DateTime? // null until graph indexing succeeds; re-index sweeps nulls

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, occurredAt])
  @@index([organizationId, source, action])
  @@index([organizationId, indexedAt])
  @@map("activity_events")
}

/// One historical backfill run for a connected source. Cursor-checkpointed so
/// a crashed/redeployed job resumes instead of re-reading completed pages.
model ActivityBackfill {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  source         String
  connectionRef  String // e.g. SlackWorkspaceConnection.id
  window         String // '90d' | '1y' | 'all'
  status         String    @default("pending") // pending | running | partial | done | failed
  cursor         String?
  eventsIngested Int       @default(0)
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, source, connectionRef])
  @@map("activity_backfills")
}

/// Atomic idempotency ledger for activity→flow dispatch: one row per
/// (event, flow) claimed. The unique constraint IS the mechanism — a racing
/// duplicate hits P2002 and loses (same pattern as SlackProcessedEvent).
model ActivityTriggerClaim {
  id        String   @id @default(cuid())
  eventId   String
  flowId    String
  createdAt DateTime @default(now())

  @@unique([eventId, flowId])
  @@index([createdAt])
  @@map("activity_trigger_claims")
}

/// A file uploaded as knowledge for an agent. We store the EXTRACTED TEXT (no
/// blob storage); the original binary is not retained. Chunks are embedded (when
/// embeddings are configured) and retrieved into the agent's context at run time.
model KnowledgeDocument {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  agentId        String? // the agent this knowledge belongs to (null = org-wide)
  userId         String?
  filename       String
  mimeType       String
  sizeBytes      Int      @default(0)
  charCount      Int      @default(0)
  status         String   @default("ready") // ready | failed
  error          String?
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@index([organizationId, agentId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String  @id @default(cuid())
  documentId     String
  organizationId String  @db.Uuid
  agentId        String?
  ordinal        Int     @default(0)
  content        String  @db.Text
  embedding      Json? // number[] embedding, or null when embeddings are unconfigured

  /// pgvector copy of `embedding` (WS-R5). Reads/writes go through raw SQL —
  /// Prisma cannot query Unsupported columns. The Json column is legacy,
  /// kept for deploy-window safety; drop it in a future migration.
  embeddingVec Unsupported("vector(1024)")?

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, agentId])
  // HNSW index created by hand-edited migration SQL (Prisma's schema DSL has
  // no `hnsw`/`vector_cosine_ops` vocabulary); declaring it here keeps
  // `prisma migrate diff` from proposing to drop it as drift.
  @@index([embeddingVec], map: "knowledge_chunks_embedding_vec_hnsw")
  @@map("knowledge_chunks")
}

/// A user-authored skill in the PUBLIC community library: readable by every
/// workspace, writable only by the creator's org. Attached to agents by id and
/// composed into the system prompt at run time alongside built-in skills.
model SharedSkill {
  id             String   @id @default(cuid())
  name           String
  description    String   @default("")
  category       String   @default("Community")
  instructions   String   @db.Text
  tags           Json     @default("[]")
  integrations   Json     @default("[]")
  authorName     String   @default("")
  organizationId String   @db.Uuid
  userId         String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Org deletion cascades community skills — an orphaned skill has no owner able to edit or retire it.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([isActive, updatedAt])
  @@map("shared_skills")
}

enum Plan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  ADMIN
  USER
}
