{
  "name": "sublime-studio",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker:dev\"",
    "build": "prisma generate && node scripts/vercel-migrate.mjs && next build",
    "start": "next start",
    "worker:dev": "tsx watch src/lib/workers/runtime.ts",
    "worker:start": "tsx src/lib/workers/runtime.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "TSX_TSCONFIG_PATH=tsconfig.test.json tsx --test $(find src -type f \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -path '*__tests__*')",
    "eval": "tsx --test $(find src/lib/eval -type f -name '*.test.ts' -path '*__tests__*')"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@nangohq/frontend": "^0.70.9",
    "@nangohq/node": "^0.70.9",
    "@prisma/client": "^6.14.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@react-pdf/renderer": "^4.5.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/nextjs": "^10.63.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "@types/web-push": "^3.6.4",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.11.2",
    "bullmq": "^5.58.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "fastify": "^5.5.0",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.513.0",
    "mammoth": "^1.12.0",
    "motion": "^12.42.2",
    "neo4j-driver": "^6.2.0",
    "next": "^15.5.19",
    "next-themes": "^0.4.6",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "pyodide": "^314.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.5",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.3.0",
    "three": "^0.185.1",
    "tsx": "^4.20.5",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.185.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.19",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "prisma": "^6.14.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
